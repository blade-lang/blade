/**
 * @module fmt.layout
 *
 * Builds the layout document for a parsed program: what each statement,
 * declaration and expression prints as, and every place it may break.
 *
 * The line breaks the author wrote are the layout. Wherever the document
 * offers a break and the source already had one, the break is kept, and
 * a list, chain or condition the author spread out keeps its lines and
 * breaks elsewhere only where the width needs it. One written on a
 * single line is the formatter's to break, and only when it does not
 * fit. Breaks are only ever offered where the parser accepts one.
 *
 * The document is built in source order, which is what lets every
 * comment be placed where it was written: each piece of code takes the
 * comments that came before it.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import .doc { * }

# How wide a `when` or `default` arm may run on one line before its
# body is braced instead.
var _ARM_WIDTH = 60

# Statements that declare a name. Braces around one would give it a
# scope of its own, so an unbraced body that declares stays unbraced.
var _DECLARING = ['Var', 'VarList', 'Decl', 'Function']

# Node kinds that are written exactly as the source has them.
var _LEAVES = [
  'Nil', 'Bool', 'Integer', 'Float', 'BigNumber', 'Literal', 'Interpolation',
  'Identifier', 'Self', 'Parent',
]

# The two quotes a string, or a dictionary key written as one, opens with.
var _QUOTES = ['\'', '"']

# Every node but the comments, which are placed from the source instead.
def _code(nodes: list) {
  return nodes.filter(
    @(node) => node.kind != 'Comment' and node.kind != 'DocBlock',
  )
}

# Whether `node` is a `nil` the source left out, as after a bare
# `return`: it has no text at all.
def _implicit(node) {
  return node.start == node.end
}

# Whether a lone item hugs the brackets around it, `f(g(` or `f([`,
# rather than taking a line of its own when it does not fit: an item
# that opens brackets of its own, which is where it breaks instead, or
# one that cannot break at all and would be no shorter on its own line.
def _hugs(node) {
  if _LEAVES.contains(node.kind) {
    return true
  }

  using node.kind {
    when 'Call', 'List', 'Dict', 'Grouping', 'Index', 'Slice', 'Get' {
      return true
    }
    when 'Anonymous' {
      return node.fields.declaration.fields.body.kind == 'Block'
    }
  }

  return false
}

# How tightly an operator binds, loosest first. Operators of one level
# are laid out as one run; `0` is anything that is not an operator.
def _level(node) {
  using node.kind {
    when 'Circuit' return node.fields.op == 'Or' ? 1 : 2
    when 'Logical' return 3
    when 'Binary' {
      using node.fields.op {
        when 'EqualEq', 'BangEq' return 3
        when 'Bar' return 4
        when 'Xor' return 5
        when 'Amp' return 6
        when 'Lshift', 'Rshift', 'Urshift' return 7
        when 'Plus', 'Minus' return 8
        when 'Multiply', 'Divide', 'Floor', 'Percent' {
          return 9
        }
        when 'Pow' return 10
      }
    }
  }

  return 0
}

# The operands of a run of operators of one level, left to right.
# `a + b - c` is one run of three; `**` groups to the right and is never
# a run of more than two.
def _operands(node) {
  var level = _level(node)
  var backwards = []
  var current = node

  while current.kind == node.kind and _level(current) == level {
    backwards.append(current.fields.right)
    current = current.fields.left

    if level == 10 {
      break
    }
  }

  backwards.append(current)

  return backwards.reverse()
}

/**
 * Builds layout documents for one source.
 */
class Layout {
  /**
   * @param Source source: The source being laid out, with its tokens.
   */
  @new(source) {
    self.src = source
  }

  /**
   * The document for a whole program.
   *
   * @param list nodes: Its top-level nodes, from `zuri.parse()`.
   * @returns any
   */
  program(nodes: list) {
    return self._sequence(_code(nodes), self.src.text.length(), true)
  }

  # Comments

  # A comment as it prints. A `#` comment loses any space it trailed
  # off with; a doc block that opens a line of its own moves its later
  # lines along with its first.
  _comment(token, own_line: bool) {
    if token.kind == 'Comment' {
      return token.text.rtrim()
    }

    if own_line and token.text.index_of('\n') != -1 {
      return comment(token.text, token.column - 1)
    }

    return token.text
  }

  # A gap where the layout may break. Its comments stay where they were,
  # one sharing the line with the code before it at the end of that
  # line, and a gap the source broke breaks, with a blank line kept.
  # `otherwise` is what the gap is when the source wrote none of that.
  _break(gap, otherwise) {
    if gap.comments.is_empty() and !gap.is_broken() {
      return otherwise
    }

    var out = []

    for entry in gap.comments {
      if entry.before == 0 {
        out.append([' ', self._comment(entry.token, false)])
      } else {
        out.append(entry.before >= 2 ? BLANKLINE : HARDLINE)
        out.append(self._comment(entry.token, true))
      }
    }

    if !gap.is_broken() {
      out.append(otherwise)

      return out
    }

    out.append(gap.after >= 2 ? BLANKLINE : HARDLINE)

    return out
  }

  # A gap the layout writes no break into. A comment the author left in
  # it still ends its line, since a `#` runs to the end of one.
  _loose(gap) {
    if gap.comments.is_empty() {
      return ''
    }

    var out = []

    for entry in gap.comments {
      if entry.before == 0 {
        out.append([' ', self._comment(entry.token, false)])
      } else {
        out.append([HARDLINE, self._comment(entry.token, true)])
      }
    }

    var last = gap.comments.last().token

    out.append(last.kind == 'Comment' or gap.after > 0 ? HARDLINE : ' ')

    return out
  }

  # Places the comments written before `offset`.
  _flush(offset: number) {
    return self._loose(self.src.take(offset))
  }

  # Sequences

  # Statements, members or arms, one to a line, with the comments around
  # them and the blank lines between them. `close` is where the sequence
  # ends: a block's `}`, or the end of the file when `top`. A block's
  # sequence starts with the line break after its `{`; a file's starts
  # with its first line.
  _sequence(items: list, close: number, top: bool) {
    var parts = []
    var previous = nil

    for item in items {
      parts.append(self._lead(self.src.take(item.start), previous, item, top))
      parts.append(self._item(item))
      previous = item
    }

    parts.append(self._tail(self.src.take(close), previous, top))

    return parts
  }

  # What goes before `item`: the comments since `previous` and the
  # break onto its line. A blank line the author left is kept, one at
  # most, and a declaration spanning several lines always has one on
  # either side of it, ahead of the comments that lead into it.
  _lead(gap, previous, item, top: bool) {
    var out = []
    var comments = gap.comments
    var first = previous == nil
    var at_top = first and top
    var start = 0

    # A comment on the line the code before it ended on, the previous
    # item's or the block's `{`, stays at the end of that line.
    if !comments.is_empty() and comments[0].before == 0 and !at_top {
      out.append([' ', self._comment(comments[0].token, false)])
      start = 1
    }

    var own = comments[start,]
    var blanks = own.map(@(entry) => entry.before >= 2)

    blanks.append(gap.after >= 2)

    if !first {
      if self._opens(previous) {
        blanks[0] = true
      }

      if self._opens(item) {
        var attached = blanks.length() - 1

        while attached > 0 and !blanks[attached] {
          attached -= 1
        }

        blanks[attached] = true
      }
    }

    var index = 0

    for entry in own {
      if !(at_top and index == 0) {
        out.append(blanks[index] ? BLANKLINE : HARDLINE)
      }

      out.append(self._comment(entry.token, true))
      index += 1
    }

    if !(at_top and own.is_empty()) {
      out.append(blanks[index] ? BLANKLINE : HARDLINE)
    }

    return out
  }

  # The comments after the last item, up to the block's `}` or the end
  # of the file. No blank line is left before the `}` itself.
  _tail(gap, previous, top: bool) {
    var out = []
    var comments = gap.comments
    var empty = previous == nil
    var start = 0

    if !comments.is_empty() and comments[0].before == 0 and !(empty and top) {
      out.append([' ', self._comment(comments[0].token, false)])
      start = 1
    }

    var index = start

    for entry in comments[start,] {
      if !(empty and top and index == 0) {
        out.append(entry.before >= 2 ? BLANKLINE : HARDLINE)
      }

      out.append(self._comment(entry.token, true))
      index += 1
    }

    return out
  }

  # Whether `node` is a declaration laid out across several lines: a
  # function, method or class with a body that opens.
  _opens(node) {
    var target = node.kind == 'Decl' ? node.fields.declaration : node

    using target.kind {
      when 'Function', 'Method' {
        var body = target.fields.body

        return !_code(body.fields.statements).is_empty()
          or !self.src.quiet(body.start + 1, body.end - 1)
          or self.src.breaks(body.start + 1, body.end - 1)
      }
      when 'Class' {
        var f = target.fields
        var open = self.src.next(self._class_head_end(target))

        return !_code(f.properties + f.methods).is_empty()
          or !self.src.quiet(open.end, target.end - 1)
          or self.src.breaks(open.end, target.end - 1)
      }
    }

    return false
  }

  # One item of a sequence.
  _item(node) {
    using node.kind {
      when 'Stmt' return self._item(node.fields.statement)
      when 'Decl' return self._item(node.fields.declaration)
      when 'Function' return self._function(node)
      when 'Class' return self._class(node)
      when 'Method' return self._method(node)
      when 'Property' return self._property(node)
      when 'Var' return self._var(node, true)
      when 'VarList' return self._var_list(node, true)
      when 'Expression' return self._expr(node.fields.value)
      when 'Echo' {
        return ['echo ', self._expr(node.fields.value)]
      }
      when 'Return' return self._keyword(node, 'return')
      when 'Raise' return self._keyword(node, 'raise')
      when 'Assert' return self._assert(node)
      when 'If' return self._if(node)
      when 'While' return self._while(node)
      when 'DoWhile' return self._do(node)
      when 'For' return self._for(node)
      when 'Iter' return self._iter(node)
      when 'Using' return self._using(node)
      when 'When' return self._when(node)
      when 'Default' return self._default(node)
      when 'Catch' return self._catch(node)
      when 'Import' return self._import(node)
      when 'Block' return self._block(node)
      when 'Continue' return 'continue'
      when 'Break' return 'break'
    }

    raise Error('there is no layout for a ${node.kind}')
  }

  # Blocks and bodies

  # A `{ }` block. One with statements always opens, one statement to a
  # line; an empty one stays as it was written, closed up or open.
  _block(block) {
    var lead = self._flush(block.start)
    var close = block.end - 1
    var items = _code(block.fields.statements)

    self.src.skip(block.start + 1)

    if items.is_empty() and self.src.quiet(block.start + 1, close) {
      var open = self.src.breaks(block.start + 1, close)

      self.src.skip(block.end)

      return [lead, open ? ['{', HARDLINE, '}'] : '{}']
    }

    var body = self._sequence(items, close, false)

    self.src.skip(block.end)

    return [lead, '{', nest(body), HARDLINE, '}']
  }

  # A single statement braced into a block of its own: the body of an
  # `if` or a loop written without braces. A comment trailing it on its
  # line goes inside with it.
  _braced(statement) {
    var lead = self._lead(self.src.take(statement.start), nil, statement, false)
    var item = self._item(statement)
    var trailing = self._break(self.src.take_trailing(statement.end), '')

    return ['{', nest([lead, item, trailing]), HARDLINE, '}']
  }

  # The body of an `if`, `else`, loop or arm, after its header. A block
  # is laid out as one, and anything else is braced unless it declares a
  # name, which braces would scope. A body left unbraced keeps the line
  # it was written on.
  _body(body) {
    if body.kind == 'Block' {
      return [' ', self._block(body)]
    }

    if _DECLARING.contains(body.kind) {
      var gap = self.src.take(body.start)

      if gap.is_broken() {
        return nest([self._break(gap, ''), self._item(body)])
      }

      return [self._loose(gap), ' ', self._item(body)]
    }

    return [' ', self._braced(body)]
  }

  # Whether a body ends on a `}`, the line an `else` or a `while` may
  # follow it on.
  _closes(body) {
    return !_DECLARING.contains(body.kind)
  }

  # The keyword joining a body to what follows it: `else` after an `if`
  # body, `while` after a `do` body. It follows a `}` on the same line;
  # after a body left unbraced it needs a line of its own, since that
  # body's statement ends at the line break.
  _joint(body, word: string) {
    var token = self.src.next(body.end)
    var gap = self.src.take(token.start)

    self.src.skip(token.end)

    if !self._closes(body) {
      return [self._break(gap, HARDLINE), word]
    }

    if gap.comments.is_empty() {
      return [' ', word]
    }

    return [self._break(gap, ' '), word]
  }

  # Statements

  _if(node) {
    var f = node.fields
    var out = ['if ', self._expr(f.condition), self._body(f.then)]

    if f.otherwise == nil {
      return out
    }

    out.append(self._joint(f.then, 'else'))

    if f.otherwise.kind == 'If' {
      out.append([' ', self._flush(f.otherwise.start), self._if(f.otherwise)])
    } else {
      out.append(self._body(f.otherwise))
    }

    return out
  }

  _while(node) {
    var f = node.fields

    return ['while ', self._expr(f.condition), self._body(f.body)]
  }

  _do(node) {
    var f = node.fields
    var body = self._body(f.body)
    var joint = self._joint(f.body, 'while')

    return ['do', body, joint, ' ', self._expr(f.condition)]
  }

  _for(node) {
    var f = node.fields
    var out = ['for ']

    if f.key_span != nil {
      out.append([self._flush(f.key_span.start), f.key, ', '])
    }

    out.append([self._flush(f.value_span.start), f.value, ' in '])
    self.src.skip(f.value_span.end)

    var in_word = self.src.next(f.value_span.end)

    out.append(self._flush(in_word.start))
    self.src.skip(in_word.end)
    out.append(self._expr(f.iterable))
    out.append(self._body(f.body))

    return out
  }

  # `iter init; condition; steps`. A clause left empty keeps the space
  # that shows it is there: `iter ; i < n; i++`.
  _iter(node) {
    var f = node.fields
    var out = ['iter']

    if f.initializer != nil {
      var init = f.initializer
      var spelled = self.src.next(init.start).kind == 'Var'

      if init.kind == 'VarList' {
        out.append([' ', self._var_list(init, spelled)])
      } else {
        out.append([' ', self._var(init, spelled)])
      }
    } else {
      out.append(' ')
    }

    out.append(';')

    if f.condition != nil {
      out.append([' ', self._expr(f.condition)])
    }

    out.append(';')

    if !f.steps.is_empty() {
      var steps = []
      var index = 0

      for step in f.steps {
        if index > 0 {
          steps.append(', ')
        }

        steps.append(self._expr(step))
        index += 1
      }

      out.append([' ', steps])
    }

    out.append([' ', self._block(f.body)])

    return out
  }

  _using(node) {
    var f = node.fields
    var out = ['using ', self._expr(f.subject), ' ']
    var open = self.src.next(f.subject.end)
    var close = node.end - 1
    var arms = _code(f.arms)

    out.append(self._flush(open.start))
    self.src.skip(open.end)

    if f.default_body != nil {
      var word = self.src.next(arms.is_empty() ? open.end : arms.last().end)

      arms.append({
        kind: 'Default',
        start: word.start,
        end: f.default_body.end,
        body: f.default_body,
        word_end: word.end,
      })
    }

    if arms.is_empty() and self.src.quiet(open.end, close) {
      var spread = self.src.breaks(open.end, close)

      self.src.skip(node.end)
      out.append(spread ? ['{', HARDLINE, '}'] : '{}')

      return out
    }

    var body = self._sequence(arms, close, false)

    self.src.skip(node.end)
    out.append(['{', nest(body), HARDLINE, '}'])

    return out
  }

  _when(node) {
    var f = node.fields
    var labels = []
    var index = 0

    self.src.skip(node.start + 4)

    for label in f.labels {
      if index > 0 {
        var comma = self.src.next(f.labels[index - 1].end)
        var gap = self.src.take(comma.start)

        self.src.skip(comma.end)
        labels.append([self._loose(gap), ','])
        labels.append(self._break(self.src.take(label.start), LINE))
      }

      labels.append(self._expr(label))
      index += 1
    }

    return ['when ', group(indent(labels)), self._arm(f.body)]
  }

  _default(arm) {
    self.src.skip(arm.word_end)

    return ['default', self._arm(arm.body)]
  }

  # The body of a `when` or `default` arm. Written without braces, it
  # stays on the arm's line while that line is at most `_ARM_WIDTH`
  # wide, and is braced otherwise.
  _arm(body) {
    if body.kind == 'Block' or _DECLARING.contains(body.kind) {
      return self._body(body)
    }

    var gap = self.src.take(body.start)

    if !gap.comments.is_empty() {
      return [
        ' {', nest([self._break(gap, HARDLINE), self._item(body)]), HARDLINE,
        '}',
      ]
    }

    var statement = self._item(body)
    var braced = [' {', nest([HARDLINE, statement]), HARDLINE, '}']

    return choose(_ARM_WIDTH, [' ', statement], braced)
  }

  _catch(node) {
    var f = node.fields
    var out = ['catch ', self._block(f.body)]

    if f.error_var == nil {
      return out
    }

    var as_word = self.src.next(f.body.end)

    out.append([self._flush(as_word.start), ' as '])
    self.src.skip(as_word.end)
    out.append(self._expr(f.error_var))

    if f.catch_body != nil {
      out.append([' ', self._block(f.catch_body)])
    }

    return out
  }

  # `return` and `raise`, with their value when the source gave one.
  _keyword(node, word: string) {
    var value = node.fields.value

    self.src.skip(node.start + word.length())

    if value.kind == 'Nil' and _implicit(value) {
      return word
    }

    return [word, ' ', self._expr(value)]
  }

  _assert(node) {
    var f = node.fields
    var condition = self._expr(f.condition)

    if f.message == nil {
      return ['assert ', condition]
    }

    var comma = self.src.next(f.condition.end)
    var before = self._loose(self.src.take(comma.start))

    self.src.skip(comma.end)

    var gap = self.src.take(f.message.start)
    var message = self._expr(f.message)

    return [
      'assert ',
      group(indent([condition, before, ',', self._break(gap, LINE), message])),
    ]
  }

  # `var name: type = value`, or the same without `var` in an `iter`
  # that leaves the word out.
  _var(node, spelled: bool) {
    var f = node.fields
    var out = []

    if spelled {
      out.append(f.is_constant ? 'const ' : 'var ')
    }

    out.append([self._flush(f.name_span.start), f.name])
    self.src.skip(f.name_span.end)

    if f.type_hint != nil and !_implicit(f.type_hint) {
      out.append([': ', self._type(f.type_hint)])
    }

    if !(f.value.kind == 'Nil' and _implicit(f.value)) {
      var equal = self.src.next(self.src.taken)

      out.append([self._flush(equal.start), ' = '])
      self.src.skip(equal.end)
      out.append(self._expr(f.value))
    }

    return out
  }

  # `var a = 1, b = 2`, broken after a comma where the author broke it.
  _var_list(node, spelled: bool) {
    var declarations = node.fields.declarations
    var first = declarations[0]
    var parts = []
    var index = 0

    for declaration in declarations {
      if index > 0 {
        var comma = self.src.next(declarations[index - 1].end)

        parts.append([self._flush(comma.start), ','])
        self.src.skip(comma.end)
        parts.append(self._break(self.src.take(declaration.start), LINE))
      }

      parts.append(self._var(declaration, false))
      index += 1
    }

    var word = spelled ? (first.fields.is_constant ? 'const ' : 'var ') : ''

    return [word, group(indent(parts))]
  }

  _import(node) {
    var f = node.fields
    var out = ['import ']

    if f.exported {
      out.append('@')
    }

    var previous = nil

    for segment in f.segments {
      if previous != nil and segment.start > previous.end {
        out.append(' ')
      }

      out.append(segment.text)
      previous = segment
    }

    var path_end = previous == nil ? node.start + 6 : previous.end

    self.src.skip(path_end)

    if f.imports_all or !f.elements.is_empty() {
      var open = self.src.next(path_end)

      out.append(' ')

      if f.imports_all {
        var star = self.src.next(open.end)
        var close = self.src.next(star.end)

        out.append([
          self._flush(open.start), '{ ', self._flush(star.start), '* ',
        ])
        self.src.skip(star.end)
        out.append([self._flush(close.start), '}'])
        self.src.skip(close.end)

        return out
      }

      var close = self._closer(open, f.elements)

      out.append(self._bracket(
        '{', '}', open.start, close.start, f.elements, true, true, 'expr',
      ))

      return out
    }

    if f.aliased {
      var as_word = self.src.next(path_end)

      out.append([self._flush(as_word.start), ' as '])
      self.src.skip(as_word.end)
      out.append(self._leaf(f.name))
    }

    return out
  }

  # Declarations

  _function(node) {
    var f = node.fields
    var out = ['def ', self._flush(f.name_span.start), f.name]

    self.src.skip(f.name_span.end)
    out.append(self._parameters(
      self.src.next(f.name_span.end), f.parameters, f.is_variadic,
    ))
    out.append([' ', self._block(f.body)])

    return out
  }

  _method(node) {
    var f = node.fields
    var out = []

    if f.is_static {
      out.append('static ')
    }

    out.append([self._flush(f.name_span.start), f.name])
    self.src.skip(f.name_span.end)
    out.append(self._parameters(
      self.src.next(f.name_span.end), f.parameters, f.is_variadic,
    ))
    out.append([' ', self._block(f.body)])

    return out
  }

  _property(node) {
    var f = node.fields
    var out = []

    if f.is_static {
      out.append('static ')
    }

    out.append(f.is_constant ? 'const ' : 'var ')
    out.append([self._flush(f.name_span.start), f.name])
    self.src.skip(f.name_span.end)

    if !_implicit(f.type_hint) {
      out.append([': ', self._type(f.type_hint)])
    }

    if !(f.value.kind == 'Nil' and _implicit(f.value)) {
      var equal = self.src.next(self.src.taken)

      out.append([self._flush(equal.start), ' = '])
      self.src.skip(equal.end)
      out.append(self._expr(f.value))
    }

    return out
  }

  # Where a class's header ends: after its name, or the class it builds
  # on or extends.
  _class_head_end(node) {
    var f = node.fields

    return f.superclass == nil ? f.name_span.end : f.superclass.end
  }

  _class(node) {
    var f = node.fields
    var out = ['class ', self._flush(f.name_span.start), f.name]

    self.src.skip(f.name_span.end)

    if f.superclass != nil {
      var arrow = self.src.next(f.name_span.end)

      out.append([self._flush(arrow.start), f.is_extension ? ' > ' : ' < '])
      self.src.skip(arrow.end)
      out.append(self._expr(f.superclass))
    }

    var open = self.src.next(self._class_head_end(node))
    var close = node.end - 1
    var members = _code(f.properties + f.methods).sort(
      @(a, b) => a.start - b.start,
    )

    out.append([' ', self._flush(open.start)])
    self.src.skip(open.end)

    if members.is_empty() and self.src.quiet(open.end, close) {
      var spread = self.src.breaks(open.end, close)

      self.src.skip(node.end)
      out.append(spread ? ['{', HARDLINE, '}'] : '{}')

      return out
    }

    var body = self._sequence(members, close, false)

    self.src.skip(node.end)
    out.append(['{', nest(body), HARDLINE, '}'])

    return out
  }

  # The `)` closing a parameter list or the `}` closing an import's names
  # that opened at `open`: the next token after the last item, or after
  # its trailing comma.
  _closer(open, items: list) {
    if items.is_empty() {
      return self.src.next(open.end)
    }

    var after = self.src.next(items.last().end)

    if after.kind == 'Comma' {
      return self.src.next(after.end)
    }

    return after
  }

  _parameters(open, parameters: list, variadic: bool) {
    var close = self._closer(open, parameters)

    return self._bracket(
      '(', ')', open.start, close.start, parameters, false, !variadic,
      'parameter',
    )
  }

  _parameter(node) {
    var f = node.fields
    var out = [self._flush(node.start)]

    if self.src.text[node.start] == '.' {
      out.append('...')
    }

    out.append(f.name)
    self.src.skip(f.name_span.end)

    if !_implicit(f.type_hint) {
      out.append([': ', self._type(f.type_hint)])
    }

    return out
  }

  # A type annotation, `?int|string`, written as the source spells its
  # names.
  _type(hint) {
    var lead = self._flush(hint.start)
    var names = hint.fields.types.map(
      @(name) => self.src.slice(name.start, name.end),
    )

    self.src.skip(hint.end)

    return [lead, hint.fields.nullable ? '?' : '', '|'.join(names)]
  }

  # Lists

  # A bracketed list of items separated by commas: arguments, parameters,
  # a list or dictionary literal, an import's names.
  #
  # A list the author wrote on one line is the formatter's: kept flat
  # when it fits, otherwise opened out with as many items to a line as
  # fit and a trailing comma. One the author broke keeps its lines while
  # they fit, the opener's and closer's breaks included; once a line of
  # several items runs past the width, the items are laid out again as
  # many to a line as fit. A lone item that opens brackets of its own
  # hugs these, so it breaks inside rather than moving to a line of its
  # own.
  #
  # A dictionary made up mostly of `key: value` pairs takes one pair to
  # a line instead, whenever it does not stay on one line.
  _bracket(
    open: string, close: string, open_at: number, close_at: number,
    items: list, spaced: bool, trailing: bool, kind: string,
  ) {
    var lead = self._flush(open_at)
    var count = items.length()

    self.src.skip(open_at + 1)

    if count == 0 {
      var inside = self.src.take(close_at)

      self.src.skip(close_at + 1)

      if inside.comments.is_empty() {
        return [lead, open, close]
      }

      return [
        lead, base([open, nest(self._break(inside, '')), HARDLINE, close]),
      ]
    }

    var after_open = self.src.breaks(open_at + 1, items[0].start)
    var before_close = self.src.breaks(items.last().end, close_at)
    var authored = after_open or before_close
    var index = 0

    while !authored and index < count - 1 {
      authored = self.src.breaks(items[index].end, items[index + 1].start)
      index += 1
    }

    var paired = kind == 'entry' and self._pairs(items) * 2 > count
    var space = spaced ? ' ' : ''
    var opening = nil
    var parts = []

    index = 0

    for item in items {
      var gap = self.src.take(item.start)

      if index == 0 {
        opening = gap
      } else {
        parts.append(self._separator(gap))
      }

      var item_doc = self._element(kind, item)

      if index < count - 1 {
        var comma = self.src.next(item.end)
        var before = self._loose(self.src.take(comma.start))

        self.src.skip(comma.end)
        parts.append([item_doc, before, ','])
      } else {
        var after = self.src.next(item.end)

        if after.kind == 'Comma' and after.start < close_at {
          item_doc = [item_doc, self._loose(self.src.take(after.start))]
          self.src.skip(after.end)
        }

        parts.append(item_doc)
      }

      index += 1
    }

    var closing = self.src.take(close_at)

    self.src.skip(close_at + 1)

    if paired {
      return [
        lead, self._paired(open, close, opening, parts, closing, authored),
      ]
    }

    if !authored {
      var opener = self._break(opening, '')
      var closer = self._break(closing, '')

      if count == 1 and kind != 'entry' and _hugs(items[0]) {
        return [lead, open, opener, space, parts[0], closer, space, close]
      }

      var soft = spaced ? LINE : SOFTLINE

      return [
        lead,
        group(base([
          open, opener, nest([soft, fill(parts)]),
          trailing ? if_break(',', '') : '', closer, soft, close,
        ])),
      ]
    }

    var first = after_open
      ? self._break(opening, HARDLINE)
      : [self._break(opening, ''), space]
    var last = before_close
      ? [trailing ? ',' : '', self._break(closing, HARDLINE)]
      : [self._break(closing, ''), space]

    return [lead, base([open, nest([first, fill(parts)]), last, close])]
  }

  # What separates two items of a bracketed list the author broke: the
  # comments between them, and a line break that is kept while the lines
  # around it fit.
  _separator(gap) {
    if gap.comments.is_empty() and gap.newlines == 1 {
      return KEPTLINE
    }

    return self._break(gap, LINE)
  }

  # How many entries of a dictionary are `key: value` pairs rather than
  # the shorthand `name`.
  _pairs(entries: list) {
    var count = 0

    for entry in entries {
      if !self._shorthand(entry) {
        count += 1
      }
    }

    return count
  }

  # A dictionary of `key: value` pairs: on one line when it fits there,
  # otherwise one pair to a line, its braces on lines of their own. One
  # the author broke stays broken. `parts` alternates the pairs, each
  # with its comma, and what separates them.
  _paired(
    open: string, close: string, opening, parts: list, closing, authored: bool,
  ) {
    if !authored {
      return group(base([
        open, self._break(opening, ''), nest([LINE, parts]), if_break(',', ''),
        self._break(closing, ''), LINE, close,
      ]))
    }

    var lines = []
    var index = 0

    for part in parts {
      var apart = index % 2 == 1 and (part == LINE or part == KEPTLINE)

      lines.append(apart ? HARDLINE : part)
      index += 1
    }

    return base([
      open, nest([self._break(opening, HARDLINE), lines]), ',',
      self._break(closing, HARDLINE), close,
    ])
  }

  # Whether a dictionary entry is written as the shorthand `name`: it was
  # written that way, or as `name: name` with the key a bare name.
  _shorthand(entry) {
    var key = entry.key
    var value = entry.value

    if value.kind == 'Shorthand' {
      return true
    }

    return key.kind == 'Literal'
      and !_QUOTES.contains(self.src.text[key.start])
      and value.kind == 'Identifier'
      and value.fields.name == key.fields.value
      and self.src.quiet(key.end, value.end)
  }

  # One item of a bracketed list.
  _element(kind: string, item) {
    using kind {
      when 'expr' return self._expr(item)
      when 'parameter' return self._parameter(item)
      when 'entry' return self._entry(item)
    }

    raise Error('there is no layout for a ${kind} list item')
  }

  # A dictionary entry, `key: value`. `name: name` with the key written
  # as a bare name is written as the shorthand `name`.
  _entry(entry) {
    var key = entry.key
    var value = entry.value

    if self._shorthand(entry) {
      var name = self._leaf(key)

      self.src.skip(value.end)

      return name
    }

    var key_doc = self._expr(key)
    var colon = self.src.next(key.end)
    var before = self._loose(self.src.take(colon.start))

    self.src.skip(colon.end)

    var gap = self.src.take(value.start)
    var value_doc = self._expr(value)

    if gap.is_broken() {
      return [key_doc, before, ':', indent([self._break(gap, ' '), value_doc])]
    }

    return [key_doc, before, ':', self._loose(gap), ' ', value_doc]
  }

  # Expressions

  _expr(node) {
    if _LEAVES.contains(node.kind) {
      return self._leaf(node)
    }

    using node.kind {
      when 'Unary' return self._unary(node)
      when 'Binary', 'Logical', 'Circuit' {
        return self._operators(node)
      }
      when 'Condition' return self._conditional(node)
      when 'Grouping' return self._grouping(node)
      when 'Range' return self._range(node)
      when 'Call', 'Get', 'Index', 'Slice' {
        return self._chain(node)
      }
      when 'Set' return self._set(node)
      when 'List' return self._list(node)
      when 'Dict' return self._dict(node)
      when 'Assign', 'CompoundAssign' {
        return self._assign(node)
      }
      when 'Update' return self._update(node)
      when 'Anonymous' return self._anonymous(node)
      when 'Shorthand' return self._leaf(node)
    }

    raise Error('there is no layout for a ${node.kind}')
  }

  # Code written exactly as the source has it: a name, a number, a
  # string with everything inside it.
  _leaf(node) {
    var lead = self._flush(node.start)

    self.src.skip(node.end)

    return [lead, self.src.slice(node.start, node.end)]
  }

  _unary(node) {
    var lead = self._flush(node.start)
    var operator = self.src.next(node.start)
    var operand = node.fields.operand

    self.src.skip(operator.end)

    # `- -x` written together would read as a decrement.
    var apart = operator.kind == 'Minus'
      and operand.kind == 'Unary'
      and operand.fields.op == 'Minus'

    return [lead, operator.text, apart ? ' ' : '', self._expr(operand)]
  }

  # A run of operators of one level. Written on one line, it stays there
  # when it fits and otherwise breaks at every one of its operators.
  # Broken by the author, it keeps their breaks and breaks elsewhere only
  # as the width needs.
  #
  # The operator leads the line it continues. A run holding a `-` is the
  # exception: a line opening with `-` is a new statement, so every
  # operator in it trails its line instead. Where the author broke after
  # an operator, the run follows them.
  _operators(node) {
    var operands = _operands(node)
    var count = operands.length()
    var operators = []
    var before = []
    var after = []
    var index = 0

    while index < count - 1 {
      var token = self.src.next(operands[index].end)

      operators.append(token)
      before.append(self.src.breaks(operands[index].end, token.start))
      after.append(self.src.breaks(token.end, operands[index + 1].start))
      index += 1
    }

    var authored = before.contains(true) or after.contains(true)
    var trails = after.contains(true)
      or operators.some(@(token) => token.kind == 'Minus')
    var contents = [[self._expr(operands[0])]]
    var separators = []

    index = 0

    for token in operators {
      var leading = before[index] or (!after[index] and !trails)
      var gap_before = self.src.take(token.start)

      self.src.skip(token.end)

      var gap_after = self.src.take(operands[index + 1].start)
      var right = self._expr(operands[index + 1])

      if leading {
        separators.append(self._break(gap_before, LINE))
        contents.append([token.text, self._loose(gap_after), ' ', right])
      } else {
        contents.last().append([self._loose(gap_before), ' ', token.text])
        separators.append(self._break(gap_after, LINE))
        contents.append([right])
      }

      index += 1
    }

    var parts = [contents[0]]

    index = 0

    for separator in separators {
      parts.append(separator)
      parts.append(contents[index + 1])
      index += 1
    }

    if authored {
      return indent(fill(parts))
    }

    return group(indent(parts))
  }

  # `condition ? then : otherwise`, broken before the `?` and the `:`
  # when it does not fit, or wherever the author broke it.
  _conditional(node) {
    var f = node.fields
    var question = self.src.next(f.condition.end)
    var colon = self.src.next(f.then.end)
    var marks = [question, colon]
    var sides = [[f.condition, f.then], [f.then, f.otherwise]]
    var authored = false

    for pair in sides {
      if self.src.breaks(pair[0].end, pair[1].start) {
        authored = true
      }
    }

    var contents = [[self._expr(f.condition)]]
    var separators = []
    var index = 0

    for token in marks {
      var next = sides[index][1]
      var broke_before = self.src.breaks(sides[index][0].end, token.start)
      var broke_after = self.src.breaks(token.end, next.start)
      var gap_before = self.src.take(token.start)

      self.src.skip(token.end)

      var gap_after = self.src.take(next.start)
      var right = self._expr(next)

      if broke_after and !broke_before {
        contents.last().append([self._loose(gap_before), ' ', token.text])
        separators.append(self._break(gap_after, LINE))
        contents.append([right])
      } else {
        separators.append(self._break(gap_before, LINE))
        contents.append([token.text, self._loose(gap_after), ' ', right])
      }

      index += 1
    }

    var parts = [
      contents[0], separators[0], contents[1], separators[1], contents[2],
    ]

    if authored {
      return indent(fill(parts))
    }

    return group(indent(parts))
  }

  # An expression in parentheses. Its insides break as they would
  # anywhere; the parentheses keep the breaks the author gave them.
  _grouping(node) {
    var lead = self._flush(node.start)
    var inner = node.fields.inner

    self.src.skip(node.start + 1)

    var opening = self.src.take(inner.start)
    var inner_doc = self._expr(inner)
    var closing = self.src.take(node.end - 1)

    self.src.skip(node.end)

    if !opening.is_broken() and !closing.is_broken() {
      return [
        lead, '(', self._loose(opening), inner_doc, self._loose(closing), ')',
      ]
    }

    return [
      lead,
      base([
        '(', nest([self._break(opening, ''), inner_doc]),
        self._break(closing, ''), ')',
      ]),
    ]
  }

  _range(node) {
    var f = node.fields
    var lower = self._expr(f.lower)
    var dots = self.src.next(f.lower.end)
    var before = self._flush(dots.start)

    self.src.skip(dots.end)

    return [
      lower, before, '..', self._flush(f.upper.start), self._expr(f.upper),
    ]
  }

  # A chain of calls, property reads and subscripts on one value. With
  # two or more method calls in it, it breaks before each call's `.`,
  # one call to a line, and the reads before the first call stay with
  # the value they start from. A `.` the author put at the start of a
  # line stays there.
  _chain(node) {
    var backwards = []
    var current = node

    while ['Call', 'Get', 'Index', 'Slice'].contains(current.kind) {
      backwards.append(current)
      current = current.kind == 'Call'
        ? current.fields.callee
        : current.fields.object
    }

    var links = backwards.reverse()
    var count = links.length()
    var calls = 0
    var index = 0

    while index < count - 1 {
      if links[index].kind == 'Get' and links[index + 1].kind == 'Call' {
        calls += 1
      }

      index += 1
    }

    var segments = [[self._expr(current)]]
    var separators = []
    var authored = false

    index = 0

    for link in links {
      var calling = calls >= 2
        and link.kind == 'Get'
        and index + 1 < count
        and links[index + 1].kind == 'Call'

      if link.kind == 'Get' {
        var object = link.fields.object
        var dot = self.src.next(object.end)
        var broke = self.src.breaks(object.end, link.fields.name_span.start)
        var gap = self.src.take(dot.start)

        self.src.skip(dot.end)

        var name = [self._flush(link.fields.name_span.start), link.fields.name]

        self.src.skip(link.fields.name_span.end)

        if calling or broke {
          authored = authored or broke
          separators.append(self._break(gap, calling ? SOFTLINE : ''))
          segments.append(['.', name])
        } else {
          segments.last().append([self._loose(gap), '.', name])
        }
      } else if link.kind == 'Call' {
        segments.last().append(self._arguments(link))
      } else {
        segments.last().append(self._subscript(link))
      }

      index += 1
    }

    if segments.length() == 1 {
      return segments[0]
    }

    var parts = [segments[0]]

    index = 0

    for separator in separators {
      parts.append(separator)
      parts.append(segments[index + 1])
      index += 1
    }

    if calls >= 2 and !authored {
      return group(indent(parts))
    }

    return indent(fill(parts))
  }

  _arguments(call) {
    var callee = call.fields.callee
    var open = self.src.next(callee.end)

    return self._bracket(
      '(', ')', open.start, call.end - 1, call.fields.arguments, false, true,
      'expr',
    )
  }

  # A subscript, `s[i]`, or a slice. Its commas say what it reads, so it
  # is written as it stands: `s[1,]`, `s[,3]`, `s[1, 3]`.
  _subscript(link) {
    var f = link.fields
    var open = self.src.next(f.object.end)
    var close = link.end - 1
    var out = [self._flush(open.start), '[']

    self.src.skip(open.end)

    if link.kind == 'Index' {
      var opening = self.src.take(f.index.start)
      var index_doc = self._expr(f.index)
      var closing = self.src.take(close)

      self.src.skip(link.end)

      return [
        out, nest([self._break(opening, ''), index_doc]),
        self._break(closing, ''), ']',
      ]
    }

    var parts = []

    if !_implicit(f.lower) {
      parts.append([
        self._break(self.src.take(f.lower.start), ''), self._expr(f.lower),
      ])
    }

    var comma = self.src.next(_implicit(f.lower) ? open.end : f.lower.end)

    parts.append([self._loose(self.src.take(comma.start)), ','])
    self.src.skip(comma.end)

    if !_implicit(f.upper) {
      var gap = self.src.take(f.upper.start)
      var spacer = _implicit(f.lower) ? '' : ' '

      parts.append([self._break(gap, spacer), self._expr(f.upper)])
    }

    var closing = self.src.take(close)

    self.src.skip(link.end)

    return [out, nest(parts), self._break(closing, ''), ']']
  }

  _set(node) {
    var f = node.fields
    var object = self._expr(f.object)
    var dot = self.src.next(f.object.end)
    var gap = self.src.take(dot.start)

    self.src.skip(dot.end)

    var name = [self._flush(f.name_span.start), f.name]

    self.src.skip(f.name_span.end)

    var equal = self.src.next(f.name_span.end)
    var before = self._flush(equal.start)

    self.src.skip(equal.end)

    var lead = gap.is_broken()
      ? indent([self._break(gap, ''), '.'])
      : [self._loose(gap), '.']

    return [object, lead, name, before, ' = ', self._expr(f.value)]
  }

  _list(node) {
    return self._bracket(
      '[', ']', node.start, node.end - 1, node.fields.items, false, true,
      'expr',
    )
  }

  _dict(node) {
    var f = node.fields
    var entries = []
    var index = 0

    for key in f.keys {
      var value = f.values[index]
      var end = value.end > key.end ? value.end : key.end

      entries.append({ start: key.start, end, key, value })
      index += 1
    }

    return self._bracket(
      '{', '}', node.start, node.end - 1, entries, true, true, 'entry',
    )
  }

  # `target = value` and its compound forms. Nothing breaks after the
  # operator unless the author broke it there.
  _assign(node) {
    var f = node.fields
    var target = self._expr(f.target)
    var operator = self.src.next(f.target.end)
    var before = self._loose(self.src.take(operator.start))

    self.src.skip(operator.end)

    var gap = self.src.take(f.value.start)
    var value = self._expr(f.value)

    if gap.is_broken() {
      return [
        target, before, ' ', operator.text,
        indent([self._break(gap, ' '), value]),
      ]
    }

    return [target, before, ' ', operator.text, self._loose(gap), ' ', value]
  }

  _update(node) {
    var target = node.fields.target
    var target_doc = self._expr(target)
    var operator = self.src.next(target.end)
    var before = self._loose(self.src.take(operator.start))

    self.src.skip(operator.end)

    return [target_doc, before, operator.text]
  }

  # A function written as a value: `def(x) { }`, `@(x) { }`, `@{ }` or
  # `@(x) => x`. Its body opens from the line it starts on.
  _anonymous(node) {
    var function = node.fields.declaration
    var f = function.fields
    var lead = self._flush(node.start)
    var word = self.src.next(node.start)
    var out = [word.kind == 'Def' ? 'def' : '@']

    self.src.skip(word.end)

    var after = self.src.next(word.end)
    var parameters = after.kind == 'Lparen'

    if parameters {
      out.append(self._parameters(after, f.parameters, f.is_variadic))
    }

    var body = f.body

    if body.kind != 'Block' {
      var arrow = self.src.next(self.src.taken)

      out.append([self._flush(arrow.start), ' => '])
      self.src.skip(arrow.end)
      out.append(self._expr(body.fields.value))

      return [lead, out]
    }

    var tight = word.kind != 'Def' and !parameters

    out.append([tight ? '' : ' ', self._block(body)])

    return [lead, base(out)]
  }
}
