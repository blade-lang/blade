# Tests for the printer: when a group stays on one line, how a fill
# packs its parts, and where each kind of indentation puts a line.

import test { * }

import ..doc { * }
import ..printer { render }

# A call's argument list, laid out the way the formatter lays one out.
def call(name, args: list) {
  var parts = []
  var index = 0

  for arg in args {
    if index > 0 {
      parts.append(LINE)
    }

    parts.append(index < args.length() - 1 ? '${arg},' : arg)
    index += 1
  }

  return [
    name,
    group(base([
      '(', nest([SOFTLINE, fill(parts)]), if_break(',', ''), SOFTLINE, ')',
    ])),
  ]
}

describe('groups', @{
  it('keeps a group that fits on one line', @{
    expect(render(call('f', ['a', 'b']), 80)).to_be('f(a, b)')
  })

  it('breaks a group that does not fit, and only then adds the if_break', @{
    expect(render(call('f', ['alpha', 'beta', 'gamma']), 18)).to_be(
      'f(\n  alpha, beta,\n  gamma,\n)',
    )
  })

  it('counts what follows a group on its line when deciding', @{
    var doc = [call('f', ['a', 'b']), ' + a_long_tail']

    expect(render(doc, 12)).to_be('f(\n  a, b,\n) + a_long_tail')
  })

  # A block inside a group opens on lines of its own whatever the group
  # decides, so the group only has to fit up to where the block opens.
  it('only has to fit as far as a line that always breaks', @{
    var block = base(['@{', nest([HARDLINE, 'work()']), HARDLINE, '}'])

    expect(render(call('each', ['items', block]), 20)).to_be(
      'each(items, @{\n  work()\n})',
    )
  })

  # Breaking after a line that is already past the width moves the
  # rest onto a line of its own and leaves the long one as long as it
  # was, so the group stays whole.
  it(
    'keeps a group whole when its line runs past the width before it can break',
    @{
      var doc = ['a_long_head(', group(indent(['x', LINE, '- 4'])), ')']

      expect(render(doc, 10)).to_be('a_long_head(x - 4)')
    },
  )

  it('never lays a broken group out on one line', @{
    expect(render(broken_group(['a', LINE, 'b']), 80)).to_be('a\nb')
  })
})

describe('fills', @{
  it('packs as many parts on a line as fit', @{
    var parts = ['aaa,', LINE, 'bbb,', LINE, 'ccc,', LINE, 'ddd']

    expect(render(fill(parts), 9)).to_be('aaa, bbb,\nccc, ddd')
  })

  it('keeps the breaks the author wrote while every line fits', @{
    var parts = ['aaa,', LINE, 'bbb,', KEPTLINE, 'ccc']

    expect(render(fill(parts), 9)).to_be('aaa, bbb,\nccc')
  })

  it('lays the parts out again once a line of several runs past the width', @{
    var parts = ['aaa,', LINE, 'bbb,', LINE, 'ccc,', KEPTLINE, 'ddd']

    expect(render(fill(parts), 9)).to_be('aaa, bbb,\nccc, ddd')
  })

  it('always breaks at a separator that always breaks', @{
    expect(render(fill(['a', HARDLINE, 'b', LINE, 'c']), 80)).to_be('a\nb c')
  })

  # The last part shares its line with whatever follows the fill, a
  # trailing comma or a closer, and has to fit along with it.
  it('measures its last part with what follows it on the line', @{
    var doc = [fill(['aaaa', LINE, 'bbbb']), ',)']

    expect(render(doc, 10)).to_be('aaaa\nbbbb,)')
  })
})

describe('indentation', @{
  it('indents one level past the line an indent starts on', @{
    var doc = ['x = ', group(indent(['alpha', LINE, '+ beta']))]

    expect(render(doc, 10)).to_be('x = alpha\n  + beta')
  })

  it('nests one level past what holds it', @{
    var doc = [
      'a {', nest([HARDLINE, 'b', nest([HARDLINE, 'c'])]), HARDLINE, '}',
    ]

    expect(render(doc, 80)).to_be('a {\n  b\n    c\n}')
  })

  # `f(g(` opened together closes together: each closer returns to the
  # line its opener is on rather than stepping back one level at a time.
  it('returns a closer to the line its opener is on', @{
    var inner = broken_group(base([
      'g(', nest([HARDLINE, 'x,']), HARDLINE, ')',
    ]))
    var doc = ['f(', inner, ')']

    expect(render(doc, 80)).to_be('f(g(\n  x,\n))')
  })

  it('leaves no spaces at the end of a line or on an empty one', @{
    expect(render(['a ', HARDLINE, HARDLINE, 'b'], 80)).to_be('a\n\nb')
  })
})

describe('choices and comments', @{
  it('takes the first choice while it fits within its limit', @{
    var doc = [
      'when 1',
      choose(12, ' a()', [' {', nest([HARDLINE, 'a()']), HARDLINE, '}']),
    ]

    expect(render(doc, 80)).to_be('when 1 a()')
  })

  it('takes the second choice past its limit, whatever the width', @{
    var doc = [
      'when 1',
      choose(8, ' a()', [' {', nest([HARDLINE, 'a()']), HARDLINE, '}']),
    ]

    expect(render(doc, 80)).to_be('when 1 {\n  a()\n}')
  })

  it('moves a doc block along with its first line', @{
    var doc = ['  ', comment('/**\n * text\n */', 0)]

    expect(render(doc, 80)).to_be('  /**\n   * text\n   */')
  })

  it('leaves a doc block line indented less than the block alone', @{
    var doc = comment('/**\nflush left\n   */', 2)

    expect(render(doc, 80)).to_be('/**\nflush left\n */')
  })
})
