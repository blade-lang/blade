/**
 * @module schema
 *
 * What is in a database, and changing it.
 *
 * Every engine can list its tables and describe its columns, and every
 * engine does it differently: PostgreSQL has `information_schema`,
 * SQLite has `PRAGMA table_info`. The queries have nothing in common,
 * so each adapter writes its own and they all return the same shape.
 *
 * ```zuri,ignore
 * for table in db.schema.tables() {
 *   echo table
 * }
 *
 * for column in db.schema.columns('posts') {
 *   echo '${column.name} ${column.type}${column.nullable ? "" : " not null"}'
 * }
 * ```
 *
 * This is what makes `insert()` portable: on an engine with no last
 * insert id, the insert needs a `RETURNING` clause, and the column to
 * return is the table's primary key, which is asked for here.
 *
 * ### Changing it
 *
 * Tables are created, altered, renamed and dropped through the same
 * object, described once in a `Blueprint` that the adapter turns into
 * its own engine's statements:
 *
 * ```zuri,ignore
 * db.schema.create_table('posts', @(table: Blueprint) {
 *   table.id()
 *   table.string('title', 200)
 *   table.timestamps()
 * })
 *
 * db.schema.alter_table('posts', @(table: Blueprint) {
 *   table.text('body').nullable()
 *   table.index('title')
 * })
 * ```
 *
 * A change made with no transaction open runs as a whole: inside a
 * transaction of its own on SQLite and PostgreSQL, where a failure part
 * way leaves nothing behind. MySQL and MariaDB commit at every schema
 * change, so there each statement stands once it has run. A change
 * made inside a transaction runs in it, as part of it.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import .blueprint { Blueprint }

/**
 * The description of one column, as every adapter returns it.
 *
 * | Key | Meaning |
 * | - | - |
 * | `name` | The column's name. |
 * | `type` | The engine's own name for its type. |
 * | `nullable` | Whether it accepts NULL. |
 * | `default_value` | Its default as SQL text, or nil for none. |
 * | `primary_key` | Whether it is part of the primary key. |
 * | `position` | Its position in the table, counting from one. |
 *
 * @returns dict
 */
def column_shape() {
  return {
    name: '',
    type: nil,
    nullable: true,
    default_value: nil,
    primary_key: false,
    position: 0,
  }
}

/**
 * Introspection for one connection.
 *
 * The methods here delegate to the adapter, which is where the queries
 * that differ per engine live. An adapter that has not implemented
 * introspection raises `NotSupportedError` rather than returning
 * something empty, so "this engine cannot tell you" never looks like
 * "there is nothing there".
 *
 * @printable
 */
class Schema {
  var _connection

  /**
   * @param Connection connection
   */
  @new(connection) {
    self._connection = connection
  }

  /**
   * The names of the tables in the database.
   *
   * Tables the engine keeps for itself are left out, so what comes
   * back is what the application created.
   *
   * @param string|nil schema Which schema to look in, on an engine
   *    that has them. The default schema when nil.
   * @returns list[string]
   */
  tables(schema) {
    return self._ask('tables', @(adapter) => adapter.tables(schema))
  }

  /**
   * The names of the views in the database.
   *
   * @param string|nil schema
   * @returns list[string]
   */
  views(schema) {
    return self._ask('views', @(adapter) => adapter.views(schema))
  }

  /**
   * Whether `table` exists.
   *
   * @param string table
   * @param string|nil schema
   * @returns bool
   */
  has_table(table: string, schema) {
    return self.tables(schema).contains(table)
  }

  /**
   * The columns of `table`, in order.
   *
   * @param string table
   * @param string|nil schema
   * @returns list[dict] Each as described by `column_shape()`.
   */
  columns(table: string, schema) {
    return self._ask('columns', @(adapter) => adapter.columns(table, schema))
  }

  /**
   * The names of `table`'s columns, in order.
   *
   * @param string table
   * @param string|nil schema
   * @returns list[string]
   */
  column_names(table: string, schema) {
    return self.columns(table, schema).map(@(column) => column.name)
  }

  /**
   * Whether `table` has a column called `column`.
   *
   * @param string table
   * @param string column
   * @param string|nil schema
   * @returns bool
   */
  has_column(table: string, column: string, schema) {
    return self.column_names(table, schema).contains(column)
  }

  /**
   * The name of `table`'s primary key column, or nil.
   *
   * Nil for a table with no primary key and for one whose primary key
   * spans several columns, since neither has a single column to name.
   * `primary_key_columns()` covers the composite case.
   *
   * @param string table
   * @param string|nil schema
   * @returns string|nil
   */
  primary_key(table: string, schema) {
    var columns = self.primary_key_columns(table, schema)

    return columns.length() == 1 ? columns[0] : nil
  }

  /**
   * The columns making up `table`'s primary key, in key order.
   *
   * @param string table
   * @param string|nil schema
   * @returns list[string]
   */
  primary_key_columns(table: string, schema) {
    return self._ask(
      'primary_key_columns',
      @(adapter) => adapter.primary_key_columns(table, schema),
    )
  }

  /**
   * The indexes on `table`.
   *
   * Each is `{ name, columns, unique }`.
   *
   * @param string table
   * @param string|nil schema
   * @returns list[dict]
   */
  indexes(table: string, schema) {
    return self._ask('indexes', @(adapter) => adapter.indexes(table, schema))
  }

  /**
   * The foreign keys declared on `table`.
   *
   * Each is `{ columns, references_table, references_columns,
   * on_delete, on_update }`.
   *
   * @param string table
   * @param string|nil schema
   * @returns list[dict]
   */
  foreign_keys(table: string, schema) {
    return self._ask(
      'foreign_keys',
      @(adapter) => adapter.foreign_keys(table, schema),
    )
  }

  /**
   * Creates a table.
   *
   * `body` is called with a `Blueprint` to describe the table on, and
   * the table is created once it returns.
   *
   * ```zuri,ignore
   * db.schema.create_table('comments', @(table: Blueprint) {
   *   table.id()
   *   table.references('post_id', 'posts').on_delete('cascade')
   *   table.text('body')
   *   table.timestamps()
   * })
   * ```
   *
   * @param string name
   * @param function body Called with the `Blueprint`.
   * @param dict|nil options `{ if_not_exists }`, false by default:
   *    when true, a table of that name that exists already is left as
   *    it is, indexes included, rather than an error.
   * @throws QueryError if the description is not a table, or the
   *    engine refuses it.
   */
  create_table(name: string, body: function, options) {
    var blueprint = Blueprint(name, true)

    body(blueprint)

    var settings = options or {}

    self._change(@(ddl) {
      ddl.create_table(self._connection, blueprint, settings)
    })
  }

  /**
   * Changes a table that exists.
   *
   * `body` is called with a `Blueprint` on which each change is
   * described, and they are made in the order they were described once
   * it returns.
   *
   * ```zuri,ignore
   * db.schema.alter_table('posts', @(table: Blueprint) {
   *   table.string('slug', 200).nullable().unique()
   *   table.string('title', 300).change()
   *   table.rename_column('body', 'content')
   *   table.drop_column('views')
   * })
   * ```
   *
   * On SQLite, a change its `ALTER TABLE` cannot make is made by
   * building the table again, which needs foreign keys switched off and
   * so cannot happen inside a transaction while they are on. Made with
   * no transaction open, or inside a migration, it always can.
   *
   * @param string name
   * @param function body Called with the `Blueprint`.
   * @throws QueryError if a change names what is not there, or the
   *    engine refuses it.
   * @throws NotSupportedError if SQLite has to build the table again
   *    inside a transaction while foreign keys are on.
   */
  alter_table(name: string, body: function) {
    var blueprint = Blueprint(name, false)

    body(blueprint)

    self._change(@(ddl) {
      ddl.alter_table(self._connection, blueprint)
    })
  }

  /**
   * Drops a table.
   *
   * A table another table refers to through a foreign key is refused,
   * rather than taking the referring rows with it.
   *
   * @param string name
   * @param dict|nil options `{ if_exists }`, false by default: when
   *    true, a table that is not there is left alone rather than an
   *    error.
   * @throws QueryError if the table is not there, or another refers to
   *    it.
   */
  drop_table(name: string, options) {
    var settings = options or {}

    self._change(@(ddl) {
      ddl.drop_table(self._connection, name, settings)
    })
  }

  /**
   * Renames a table. Foreign keys referring to it follow it; its
   * indexes keep the names they had.
   *
   * @param string from
   * @param string to
   */
  rename_table(from: string, to: string) {
    self._change(@(ddl) {
      ddl.rename_table(self._connection, from, to)
    })
  }

  # Runs a change in the caller's transaction, or as a change of its
  # own when there is none.
  _change(body) {
    var connection = self._connection
    var ddl = connection.driver().ddl()

    if connection.in_transaction() {
      return body(ddl)
    }

    return ddl.schema_change(connection, @(_transaction) {
      return body(ddl)
    }, true)
  }

  # Runs `body` against the adapter's introspection. An adapter with
  # none raises from `schema_adapter()` itself, which is where the
  # message naming the engine belongs.
  _ask(what, body) {
    return body(self._connection.driver_connection().schema_adapter())
  }

  to_string() {
    return '<Schema for ${self._connection.driver_name()}>'
  }

  @to_string() {
    return self.to_string()
  }
}
