/**
 * @module zuri.watch
 *
 * What a program tells `zuri run --watch` about the files it depends
 * on.
 *
 * Watch mode restarts a program when a file it depends on changes. The
 * runtime reports the Zuri source it reads by itself: the entry file
 * and every module imported from it, at the top of a file or inside a
 * function, in any isolate. What the runtime cannot see is a file a
 * library reads as data while the program's behaviour still comes from
 * it, the way `wire` reads templates. A library declares each such file
 * with `depends_on()`:
 *
 * ```zuri
 * import json
 * import zuri.watch
 *
 * def load_rules(path: string) {
 *   watch.depends_on(path)
 *
 *   return json.decode(file(path).read())
 * }
 * ```
 *
 * Outside watch mode both functions return at once and do nothing, so
 * a library calls `depends_on()` unconditionally rather than asking
 * `active()` first.
 *
 * The module is its own import, apart from the rest of the `zuri`
 * package, so a library reaching for it does not load the parser and
 * compiler along with it.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import _zuri_watch

/**
 * Tells watch mode that this program depends on the file at `path`, so
 * that a change to it restarts the program.
 *
 * Call it when the file is read. A file declared and then changed
 * before watch mode has started watching it is still noticed, because
 * the file's content is recorded along with its path. A path with
 * nothing at it yet is recorded too, and creating the file restarts
 * the program.
 *
 * Only the first declaration of a file is recorded, and declaring it
 * again costs a lookup and nothing more, so a function may declare a
 * file every time it reads it. Files in the standard library are never
 * recorded, since they change only when Zuri itself is upgraded.
 *
 * @param string path: absolute, or relative to the working directory.
 * @returns bool: `true` when the program runs under `zuri run --watch`
 *    and the file was recorded, `false` otherwise.
 */
def depends_on(path: string) {
  return _zuri_watch.depends_on(path)
}

/**
 * Whether this program is running under `zuri run --watch`.
 *
 * @returns bool
 */
def active() {
  return _zuri_watch.active()
}
