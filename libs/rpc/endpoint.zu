/**
 * @module endpoint
 *
 * {Endpoint}: one side of a JSON-RPC connection. It answers the
 * requests and notifications the other side sends, and sends its own.
 * JSON-RPC makes no difference between a client and a server, so the
 * same endpoint can do both on one connection.
 *
 * Re-exported by `rpc`.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import json
import isolate
import zuri
import .error { * }
import .message { Request, Notification, Response }
import .message as messages
import .framing { HeaderFraming }

# How much of a stream is read at a time.
const _CHUNK = 65536

# The `id` a malformed message is answered with: its own, when it has
# one that can be read, and `nil` otherwise.
def _answer_id(value) {
  if !is_dict(value) or !value.contains('id') {
    return nil
  }

  var id = value.get('id', nil)

  if id == nil or is_string(id) or is_number(id) {
    return id
  }

  return nil
}

# True for a value that has the shape of a response, which JSON-RPC
# never answers, even when it is malformed.
def _looks_like_response(value) {
  return is_dict(value) and !value.contains('method') and (
    value.contains('result') or value.contains('error')
  )
}

# Turns the bytes of one message into the item `Endpoint.dispatch()`
# takes: its text and the value decoded from it, or the parse error
# it is answered with.
def _decode(body: bytes) {
  var text = body.to_string()

  # `to_string()` reads whatever is not UTF-8 as U+FFFD, so only valid
  # text encodes back to the bytes it came from.
  if text.to_bytes() != body {
    return {
      kind: 'unreadable',
      text: nil,
      message: 'Parse error: a message is not valid UTF-8',
    }
  }

  catch {
    return { kind: 'message', text, value: json.decode(text) }
  } as error {
    return { kind: 'unreadable', text, message: 'Parse error: ${error.message}' }
  }
}

# Runs on an isolate of its own for `Endpoint.listen()`: reads the
# transport, splits it into messages, decodes them, and hands each
# one to `inbox`.
def _read(transport, framing, inbox) {
  catch {
    while true {
      var data = transport.read(_CHUNK)

      if data.is_empty() {
        break
      }

      for body in framing.feed(data) {
        inbox.send(_decode(body))
      }
    }

    inbox.send({ kind: 'closed' })
  } as error {
    inbox.send({ kind: 'failed', message: error.message })
  }
}

/**
 * What a handler is told about the message it is handling: the
 * request's `id`, its `method`, and the `endpoint` it arrived on.
 *
 * A request handler normally answers by returning. One that cannot
 * answer before it returns, because the answer comes from work still
 * to be done, calls `defer()`, keeps the context, and answers through
 * it with `reply()` or `fail()` once the answer is ready.
 *
 * @printable
 */
class Context {

  /**
   * Returns a new {Context}. An endpoint makes one for each message
   * it hands to a handler.
   *
   * @param Endpoint endpoint: The endpoint the message arrived on.
   * @param string|number|nil id: The request's `id`; `nil` for a
   *    notification.
   * @param string method: The method called.
   * @param bool is_request: Whether the message is a request, which
   *    is answered, rather than a notification, which is not.
   */
  @new(endpoint, id, method: string, is_request: bool) {
    self.endpoint = endpoint
    self.id = id
    self.method = method
    self._is_request = is_request
    self._deferred = false
    self._answered = false
  }

  /**
   * True when the message is a notification, which nothing answers.
   *
   * @returns bool
   */
  is_notification() {
    return !self._is_request
  }

  /**
   * Takes over answering the request: whatever the handler returns
   * is ignored, and the request is answered when `reply()` or
   * `fail()` is called, from the isolate that owns the endpoint.
   * Calling it again changes nothing.
   *
   * A request deferred from inside a batch is answered on its own,
   * after the batch's other answers.
   *
   * @returns Context itself.
   * @throws ValueError for a notification, which is never answered.
   */
  defer() {
    if !self._is_request {
      raise ValueError('a notification is never answered')
    }

    self._deferred = true

    return self
  }

  /**
   * True once `defer()` has been called.
   *
   * @returns bool
   */
  is_deferred() {
    return self._deferred
  }

  /**
   * Answers the deferred request with `result`.
   *
   * @param any result
   * @throws ValueError when the request was not deferred, or has
   *    already been answered.
   * @throws RpcClosedError when the endpoint has been closed.
   */
  reply(result) {
    self._answer(Response.success(self.id, result))
  }

  /**
   * Answers the deferred request with `error`.
   *
   * @param RpcError error
   * @throws ValueError when the request was not deferred, or has
   *    already been answered.
   * @throws RpcClosedError when the endpoint has been closed.
   */
  fail(error) {
    self._answer(Response.failure(self.id, error))
  }

  /**
   * True once a deferred request has been answered.
   *
   * @returns bool
   */
  is_answered() {
    return self._answered
  }

  _answer(response) {
    if !self._deferred {
      raise ValueError('only a deferred request is answered through its context')
    }

    if self._answered {
      raise ValueError('request #${self.id} has already been answered')
    }

    self._answered = true
    self.endpoint.send(response)
  }

  /**
   * This context as `Context(method #id)`.
   *
   * @returns string
   */
  to_string() {
    return 'Context(${self.method} #${self.id})'
  }

  @to_string() {
    return self.to_string()
  }
}

/**
 * One side of a JSON-RPC connection over a transport.
 *
 * Handlers say what it answers. A request handler is called with the
 * request's `params` and a {Context}, and what it returns is the
 * result sent back; an {RpcError} it raises is sent back as that
 * error, and any other error as an `INTERNAL_ERROR` carrying its
 * message. A notification handler is called the same way and nothing
 * is sent back. A message for a method with no handler goes to the
 * `on_unhandled()` fallback when one is set; without one, a request
 * is answered with `METHOD_NOT_FOUND` and a notification is dropped.
 * A message that is not valid UTF-8, or not valid JSON, is answered
 * with `PARSE_ERROR`.
 *
 * ```zuri
 * import rpc
 * import isolate
 *
 * var ends = rpc.pipe()
 *
 * # The server runs on an isolate of its own, answering until the
 * # client closes its end.
 * isolate.spawn(@(transport) {
 *   import rpc
 *
 *   rpc.endpoint(transport)
 *     .on_request('add', @(params) => params[0] + params[1])
 *     .serve()
 * }, ends[1])
 *
 * var client = rpc.endpoint(ends[0])
 *
 * echo client.request('add', [2, 3])  # 5
 * client.close()
 * ```
 *
 * An endpoint reads its transport in one of two ways. `serve()` reads
 * and answers until the connection ends, on the isolate that calls
 * it. `listen()` reads on an isolate of its own and returns a
 * `Channel` of what arrives, for a program that waits on other things
 * as well; it passes each one to `dispatch()` when it is ready to
 * handle it. Either way, every handler runs on the isolate that owns
 * the endpoint, and everything is sent from there.
 *
 * @printable
 */
class Endpoint {

  /**
   * Returns a new {Endpoint} over `transport`, framing its messages
   * with a {HeaderFraming}.
   *
   * @param any transport: A transport; see `rpc.transport`.
   */
  @new(transport) {
    self._transport = transport
    self._framing = HeaderFraming()
    self._request_handlers = {}
    self._notification_handlers = {}
    self._unhandled = nil
    self._error_handler = nil
    self._trace_handler = nil
    self._next_id = 1
    self._callbacks = {}
    self._answers = {}
    self._inbox = nil
    self._reader = nil
    self._ended = false
    self._closed = false
    self._stopped = false
  }

  /**
   * Sets how messages are told apart in the stream. Set it before
   * `listen()`, which hands the framing to the isolate it reads on.
   *
   * @param HeaderFraming|LineFraming framing: Default
   *    `HeaderFraming()`.
   * @returns Endpoint itself.
   */
  set_framing(framing) {
    self._framing = framing

    return self
  }

  /**
   * Answers requests for `method` with `handler`, in place of any
   * handler set for it before.
   *
   * @param string method: The method's name. Names starting with
   *    `rpc.` are reserved by JSON-RPC.
   * @param function(2) handler: Called with the request's `params`
   *    and a {Context}; what it returns is the result sent back.
   * @returns Endpoint itself.
   * @throws ValueError for a name starting with `rpc.`.
   */
  on_request(method: string, handler: function) {
    _check_method(method)
    self._request_handlers[method] = handler

    return self
  }

  /**
   * Handles notifications for `method` with `handler`, in place of
   * any handler set for it before.
   *
   * @param string method: The method's name. Names starting with
   *    `rpc.` are reserved by JSON-RPC.
   * @param function(2) handler: Called with the notification's
   *    `params` and a {Context}; what it returns is ignored.
   * @returns Endpoint itself.
   * @throws ValueError for a name starting with `rpc.`.
   */
  on_notification(method: string, handler: function) {
    _check_method(method)
    self._notification_handlers[method] = handler

    return self
  }

  /**
   * Handles every request and notification whose method has no
   * handler of its own, in place of any fallback set before. It is
   * called as the other handlers are, with `context.method` naming
   * the method. For a request, what it returns is the result sent
   * back, and raising an {RpcError} with `METHOD_NOT_FOUND` refuses
   * the method as an endpoint without a fallback would.
   *
   * A method whose name starts with `rpc.` never reaches it: JSON-RPC
   * reserves those names, so such a request is answered with
   * `METHOD_NOT_FOUND` and such a notification is dropped.
   *
   * @param function(2) handler: Called with the message's `params`
   *    and a {Context}.
   * @returns Endpoint itself.
   */
  on_unhandled(handler: function) {
    self._unhandled = handler

    return self
  }

  /**
   * Called with every problem the other side is not told about: an
   * error a notification handler raised, an error other than an
   * {RpcError} a request handler raised, an error a `send_request()`
   * callback raised, a response nothing was waiting for, and a
   * connection that failed.
   *
   * @param function(2) handler: Called with the error and the
   *    message it concerns, as a dictionary, or `nil` when there is
   *    no one message.
   * @returns Endpoint itself.
   */
  on_error(handler: function) {
    self._error_handler = handler

    return self
  }

  /**
   * Called with the text of every message, as it is sent and as it
   * arrives, for logging a conversation.
   *
   * @param function(2) handler: Called with `'in'` or `'out'` and the
   *    message's JSON text.
   * @returns Endpoint itself.
   */
  on_trace(handler: function) {
    self._trace_handler = handler

    return self
  }

  /**
   * Sends a notification: calls `method` on the other side and
   * expects nothing back.
   *
   * @param string method
   * @param list|dict|nil params: Default `nil`, which sends none.
   * @throws RpcClosedError when the endpoint has been closed.
   */
  notify(method: string, params) {
    self.send(Notification(method, params))
  }

  /**
   * Sends a request and returns at once; `callback` is called with
   * the answer when it arrives, on the isolate that owns the
   * endpoint, while it serves, waits on a request, or dispatches.
   *
   * @param string method
   * @param list|dict|nil params
   * @param function(2) callback: Called with the result and `nil`, or
   *    with `nil` and the error: an {RpcError} the other side
   *    answered with, or an {RpcClosedError} when the connection
   *    ended first.
   * @returns int: The request's `id`.
   * @throws RpcClosedError when the endpoint has been closed.
   */
  send_request(method: string, params, callback: function) {
    var id = self._take_id()

    self.send(Request(method, params, id))
    self._callbacks[id] = callback

    return id
  }

  /**
   * Sends a request and waits for its answer, handling whatever else
   * arrives in the meantime as `serve()` would.
   *
   * ```zuri,ignore
   * var sum = endpoint.request('add', [2, 3])
   * ```
   *
   * An error answer that names no request, which the other side sends
   * for a message it cannot read at all, goes to `on_error()` rather
   * than to any one request.
   *
   * @param string method
   * @param list|dict|nil params
   * @param ?number timeout: The most seconds to wait. Default `nil`,
   *    which waits until the answer comes or the connection ends. A
   *    timeout needs the endpoint to be listening; one reading its
   *    transport itself waits as long as the transport's reads do.
   * @returns any: The result the other side answered with.
   * @throws RpcError when the other side answers with an error.
   * @throws RpcClosedError when the endpoint has been closed, or the
   *    connection ends before the answer.
   * @throws RpcTimeoutError when `timeout` runs out first.
   */
  request(method: string, params, timeout: ?number) {
    var call = Request(method, params, self._take_id())

    self.send(call)
    self._answers[call.id] = false

    var answer = self._await([call.id], method, timeout)[0]

    if answer.is_error() {
      raise answer.error
    }

    return answer.result
  }

  /**
   * Sends several requests as one batch and waits for every answer,
   * handling whatever else arrives in the meantime as `request()`
   * does. The other side may answer them in any order; they come
   * back in the order of `calls`.
   *
   * ```zuri,ignore
   * var sums = endpoint.request_batch([['add', [1, 2]], ['add', [3, 4]]])
   * ```
   *
   * @param list calls: Each call as a pair, `[method, params]`.
   * @param ?number timeout: The most seconds to wait for every
   *    answer, as for `request()`.
   * @returns list: For each call, in order, the result the other
   *    side answered with, or the {RpcError} it answered with.
   * @throws ValueError when `calls` is empty, or a call is not a
   *    `[method, params]` pair.
   * @throws RpcClosedError when the endpoint has been closed, or the
   *    connection ends before every answer.
   * @throws RpcTimeoutError when `timeout` runs out first.
   */
  request_batch(calls: list, timeout: ?number) {
    if calls.is_empty() {
      raise ValueError('a batch must hold at least one call')
    }

    var batch = []

    for call in calls {
      if !is_list(call) or call.length() != 2 or !is_string(call[0]) {
        raise ValueError('each call is a [method, params] pair')
      }

      batch.append(Request(call[0], call[1], self._take_id()))
    }

    var ids = batch.map(@(call) => call.id)

    self.send(batch)

    for id in ids {
      self._answers[id] = false
    }

    return self._await(ids, 'the batch', timeout).map(@(answer) {
      return answer.is_error() ? answer.error : answer.result
    })
  }

  /**
   * Sends a message as it is: a {Request}, a {Notification}, a
   * {Response}, or a list of them as a batch.
   *
   * @param Request|Notification|Response|list message
   * @throws RpcClosedError when the endpoint has been closed.
   */
  send(message) {
    if self._closed {
      raise RpcClosedError('the endpoint has been closed')
    }

    var text = messages.encode(message)

    self._trace('out', text)
    self._transport.write(self._framing.frame(text))
  }

  /**
   * Reads and answers messages until the connection ends, `stop()` is
   * called, or the endpoint is closed. On a listening endpoint, it
   * takes what arrives from the `Channel` `listen()` returned.
   *
   * A message that is not valid UTF-8, or not valid JSON, is answered
   * with `PARSE_ERROR` and an `id` of `nil`.
   *
   * @throws RpcFramingError when the stream cannot be read past a
   *    message.
   */
  serve() {
    self._stopped = false

    while !self._stopped and !self._ended and !self._closed {
      if self._inbox == nil {
        self._pump()
      } else {
        var item = self._inbox.recv()
        self.dispatch(item == nil ? { kind: 'closed' } : item)
      }
    }
  }

  /**
   * Makes `serve()` return once the message it is handling is done.
   */
  stop() {
    self._stopped = true
  }

  /**
   * Starts reading the transport on an isolate of its own, and
   * returns the `Channel` each message is put on as it arrives,
   * already decoded from JSON. Pass each item taken from it to
   * `dispatch()`, on the isolate that owns the endpoint, when the
   * program is ready to handle it.
   *
   * ```zuri,ignore
   * var inbox = endpoint.listen()
   *
   * while !endpoint.is_closed() {
   *   var ready = isolate.select([inbox, work], 0.5)
   *
   *   if ready[0] == inbox {
   *     endpoint.dispatch(ready[1])
   *   }
   * }
   * ```
   *
   * Each item is a dictionary whose `kind` says what arrived:
   *
   * - `{ kind: 'message', text, value }`: a message, as its JSON text
   *   and the value decoded from it.
   * - `{ kind: 'unreadable', text, message }`: a message that is not
   *   valid JSON, with `text` `nil` when it is not valid UTF-8
   *   either, and the parse error it is answered with.
   * - `{ kind: 'closed' }`: the end of the connection.
   * - `{ kind: 'failed', message }`: a failure reading the
   *   transport, which ends the connection.
   *
   * Calling `listen()` again returns the same `Channel`.
   *
   * @returns isolate.Channel
   * @throws ValueError when the transport cannot be read from
   *    another isolate; see `can_listen()` in `rpc.transport`.
   */
  listen() {
    if self._inbox != nil {
      return self._inbox
    }

    var shared = zuri.reflect.has_method(self._transport, 'can_listen')

    if !shared or !self._transport.can_listen() {
      raise ValueError('${self._transport} is read by the isolate that holds it; use serve()')
    }

    var inbox = isolate.channel()

    self._reader = isolate.spawn(_read, self._transport, self._framing, inbox)
    self._inbox = inbox

    return inbox
  }

  /**
   * Handles one item taken from the `Channel` `listen()` returned:
   * answers a message, or marks the connection ended. A failed
   * connection is reported to `on_error()` with an {RpcClosedError}.
   *
   * @param dict item
   */
  dispatch(item: dict) {
    using item.kind {
      when 'message' self._receive(item.text, item.value)
      when 'unreadable' self._refuse(item.text, item.message)
      when 'closed' self._end()
      when 'failed' {
        self._report(RpcClosedError('the connection failed: ${item.message}'), nil)
        self._end()
      }
    }
  }

  /**
   * Handles one message already decoded from JSON, or a batch of
   * them, exactly as if it had just arrived.
   *
   * @param any value: A value as `json.decode()` returns it.
   */
  handle(value) {
    if !is_list(value) {
      var answer = self._handle_one(value)

      if answer != nil {
        self.send(answer)
      }

      return
    }

    if value.is_empty() {
      var empty = RpcError(INVALID_REQUEST, 'Invalid Request: a batch must not be empty')
      self.send(Response.failure(nil, empty))
      return
    }

    var answers = []

    for entry in value {
      var answer = self._handle_one(entry)

      if answer != nil {
        answers.append(answer)
      }
    }

    if !answers.is_empty() {
      self.send(answers)
    }
  }

  /**
   * Closes the transport. Nothing more can be sent, and every request
   * still waiting is answered with an {RpcClosedError}.
   */
  close() {
    if self._closed {
      return
    }

    self._closed = true
    self._transport.close()
    self._fail_waiting()
  }

  /**
   * True once the endpoint is closed or the connection has ended.
   *
   * @returns bool
   */
  is_closed() {
    return self._closed or self._ended
  }

  /**
   * This endpoint as `Endpoint(transport)`.
   *
   * @returns string
   */
  to_string() {
    return 'Endpoint(${self._transport})'
  }

  @to_string() {
    return self.to_string()
  }

  _take_id() {
    var id = self._next_id
    self._next_id++

    return id
  }

  _trace(direction: string, text: string) {
    if self._trace_handler != nil {
      self._trace_handler(direction, text)
    }
  }

  _report(error, value) {
    if self._error_handler != nil {
      self._error_handler(error, value)
    }
  }

  # Reads the transport once and answers every message that completes.
  _pump() {
    var data = self._transport.read(_CHUNK)

    if data.is_empty() {
      self._end()
      return
    }

    for body in self._framing.feed(data) {
      self.dispatch(_decode(body))
    }
  }

  _end() {
    self._ended = true
    self._fail_waiting()
  }

  _fail_waiting() {
    var waiting = self._callbacks
    self._callbacks = {}

    for id in waiting.keys() {
      var ended = RpcClosedError('the connection ended before #${id} was answered')
      self._call_back(waiting[id], nil, ended)
    }
  }

  _call_back(callback, result, error) {
    catch {
      callback(result, error)
    } as failure {
      self._report(failure, nil)
    }
  }

  _receive(text: string, value) {
    self._trace('in', text)
    self.handle(value)
  }

  # Answers a message that could not be decoded. Its `id` cannot be
  # read, so the answer has none.
  _refuse(text: ?string, message: string) {
    if text != nil {
      self._trace('in', text)
    }

    self.send(Response.failure(nil, RpcError(PARSE_ERROR, message)))
  }

  # Handles what arrives until every one of `ids` is answered, and
  # returns their answers in the same order.
  _await(ids: list, label: string, timeout: ?number) {
    var deadline = timeout == nil ? nil : time() + timeout

    while !self._ended and ids.some(@(id) => self._answers[id] == false) {
      if self._inbox == nil {
        self._pump()
        continue
      }

      var remaining = deadline == nil ? nil : deadline - time()
      var item = nil

      if remaining != nil and remaining <= 0 {
        self._forget(ids)
        raise RpcTimeoutError('no answer to ${label} within ${timeout} seconds')
      }

      catch {
        item = self._inbox.recv(remaining)
      } as error {
        if !instance_of(error, isolate.IsolateTimeoutError) {
          raise error
        }

        self._forget(ids)
        raise RpcTimeoutError('no answer to ${label} within ${timeout} seconds')
      }

      self.dispatch(item == nil ? { kind: 'closed' } : item)
    }

    var answers = ids.map(@(id) => self._answers[id])
    self._forget(ids)

    if answers.contains(false) {
      raise RpcClosedError('the connection ended before ${label} was answered')
    }

    return answers
  }

  _forget(ids: list) {
    for id in ids {
      self._answers.remove(id)
    }
  }

  # Handles one message and returns the answer to send, or `nil` when
  # nothing is to be sent now.
  _handle_one(value) {
    var incoming = nil

    catch {
      incoming = messages.read(value)
    } as error {
      if !instance_of(error, RpcError) {
        raise error
      }

      if _looks_like_response(value) {
        self._report(error, value)
        return nil
      }

      return Response.failure(_answer_id(value), error)
    }

    if instance_of(incoming, Response) {
      self._accept(incoming)
      return nil
    }

    if instance_of(incoming, Notification) {
      self._notify(incoming, value)
      return nil
    }

    return self._call(incoming, value)
  }

  _accept(response) {
    var id = response.id

    if self._answers.contains(id) and self._answers[id] == false {
      self._answers[id] = response
      return
    }

    if self._callbacks.contains(id) {
      var callback = self._callbacks[id]
      self._callbacks.remove(id)
      self._call_back(callback, response.result, response.error)
      return
    }

    var stray = RpcError(INVALID_REQUEST, 'a response to #${id}, which nothing is waiting for')
    self._report(stray, response.to_dict())
  }

  # The handler for `method` from `handlers`, the fallback when it has
  # none, or `nil`. Reserved names never fall back.
  _handler_for(handlers: dict, method: string) {
    var handler = handlers.get(method, nil)

    if handler == nil and !method.starts_with('rpc.') {
      handler = self._unhandled
    }

    return handler
  }

  _notify(notification, value) {
    var handler = self._handler_for(self._notification_handlers, notification.method)

    if handler == nil {
      return
    }

    catch {
      handler(notification.params, Context(self, nil, notification.method, false))
    } as error {
      self._report(error, value)
    }
  }

  _call(request, value) {
    var handler = self._handler_for(self._request_handlers, request.method)

    if handler == nil {
      var missing = RpcError(METHOD_NOT_FOUND, 'Method not found: ${request.method}')
      return Response.failure(request.id, missing)
    }

    var context = Context(self, request.id, request.method, true)
    var result = nil

    catch {
      result = handler(request.params, context)
    } as error {
      var failure = error

      if !instance_of(error, RpcError) {
        self._report(error, value)
        failure = RpcError(INTERNAL_ERROR, error.message)
      }

      if context.is_deferred() {
        if !context.is_answered() {
          context.fail(failure)
        }

        return nil
      }

      return Response.failure(request.id, failure)
    }

    if context.is_deferred() {
      return nil
    }

    return Response.success(request.id, result)
  }
}

def _check_method(method: string) {
  if method.starts_with('rpc.') {
    raise ValueError("method names starting with 'rpc.' are reserved by JSON-RPC")
  }
}
