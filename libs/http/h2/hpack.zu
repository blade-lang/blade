#!-- part of the http module
/**
 * @module http.h2.hpack
 *
 * HPACK, the header compression HTTP/2 uses (RFC 7541).
 *
 * A header block is a sequence of representations, each of which
 * either names an entry of a table both endpoints maintain, or spells
 * a field out. The static table below is fixed by the RFC; the
 * dynamic table is built as a connection runs, which is what makes
 * the *decoder* stateful - a block cannot be decoded without every
 * block that came before it on the same connection.
 *
 * The encoder here uses the static table where it can and literals
 * everywhere else, and never adds to its own dynamic table. That
 * gives up some compression and buys a great deal: an encoder with no
 * dynamic table cannot desynchronise from a peer's decoder, and it
 * cannot leak one request's secrets into another's compression ratio,
 * which is the whole of the CRIME family of attacks.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import _http
import ..errors { ProtocolError }
import .huffman

# RFC 7541 Appendix A. Index 0 is unused - HPACK indexes from 1 - so
# the list starts with a placeholder to keep the arithmetic honest.
var _STATIC = [
  ['', ''],
  [':authority', ''],
  [':method', 'GET'],
  [':method', 'POST'],
  [':path', '/'],
  [':path', '/index.html'],
  [':scheme', 'http'],
  [':scheme', 'https'],
  [':status', '200'],
  [':status', '204'],
  [':status', '206'],
  [':status', '304'],
  [':status', '400'],
  [':status', '404'],
  [':status', '500'],
  ['accept-charset', ''],
  ['accept-encoding', 'gzip, deflate'],
  ['accept-language', ''],
  ['accept-ranges', ''],
  ['accept', ''],
  ['access-control-allow-origin', ''],
  ['age', ''],
  ['allow', ''],
  ['authorization', ''],
  ['cache-control', ''],
  ['content-disposition', ''],
  ['content-encoding', ''],
  ['content-language', ''],
  ['content-length', ''],
  ['content-location', ''],
  ['content-range', ''],
  ['content-type', ''],
  ['cookie', ''],
  ['date', ''],
  ['etag', ''],
  ['expect', ''],
  ['expires', ''],
  ['from', ''],
  ['host', ''],
  ['if-match', ''],
  ['if-modified-since', ''],
  ['if-none-match', ''],
  ['if-range', ''],
  ['if-unmodified-since', ''],
  ['last-modified', ''],
  ['link', ''],
  ['location', ''],
  ['max-forwards', ''],
  ['proxy-authenticate', ''],
  ['proxy-authorization', ''],
  ['range', ''],
  ['referer', ''],
  ['refresh', ''],
  ['retry-after', ''],
  ['server', ''],
  ['set-cookie', ''],
  ['strict-transport-security', ''],
  ['transfer-encoding', ''],
  ['user-agent', ''],
  ['vary', ''],
  ['via', ''],
  ['www-authenticate', ''],
]

var _STATIC_LENGTH = 61

# name -> the lowest static index carrying that name, and
# 'name\tvalue' -> the static index of that exact pair.
var _BY_NAME = {}
var _BY_PAIR = {}

def _index_static() {
  iter var i = 1; i <= _STATIC_LENGTH; i++ {
    var entry = _STATIC[i]

    if !_BY_NAME.contains(entry[0]) {
      _BY_NAME[entry[0]] = i
    }

    if entry[1] {
      _BY_PAIR['${entry[0]}\t${entry[1]}'] = i
    }
  }
}

_index_static()

# Header fields whose values are secret often enough that they are
# never worth entering into a compression table. A value that shares a
# table with attacker-chosen text leaks through the compressed size,
# which is the mechanism behind CRIME and BREACH.
var _NEVER_INDEXED = [
  'authorization',
  'proxy-authorization',
  'cookie',
  'set-cookie',
]

/**
 * Encodes an integer with an `prefix_bits`-wide prefix, per RFC 7541
 * §5.1. `first` is whatever flag bits share that first byte.
 *
 * @param bytes out
 * @param number value
 * @param number prefix_bits
 * @param number first: the flag bits, already shifted into place
 */
def encode_integer(out, value: number, prefix_bits: number, first: number) {
  _http.hpack_encode_integer(out, value, prefix_bits, first)
}

/**
 * Decodes an integer with an `prefix_bits`-wide prefix, starting at
 * `offset`.
 *
 * @param bytes data
 * @param number offset
 * @param number prefix_bits
 * @returns list: `[value, next offset]`
 * @throws ProtocolError if the encoding runs off the end or is
 *    absurdly long
 */
def decode_integer(data, offset: number, prefix_bits: number) {
  var res = _http.hpack_decode_integer(data, offset, prefix_bits)
  if is_list(res) {
    return res
  }

  if res == 1 {
    raise ProtocolError('truncated HPACK integer')
  }

  raise ProtocolError('HPACK integer is too large')
}

/**
 * Encodes a string literal, Huffman-coding it when that comes out
 * shorter.
 *
 * @param bytes out
 * @param string text
 */
def encode_string(out, text: string) {
  _http.hpack_encode_string(out, text)
}

/**
 * Decodes a string literal starting at `offset`.
 *
 * @param bytes data
 * @param number offset
 * @param number max_length: refuse a literal longer than this
 * @returns list: `[text, next offset]`
 * @throws ProtocolError on a truncated or over-long literal
 */
def decode_string(data, offset: number, max_length: number) {
  var res = _http.hpack_decode_string(data, offset, max_length)
  if is_list(res) {
    return res
  }

  raise ProtocolError(res)
}

/**
 * The dynamic table half of an HPACK context: the most recently
 * inserted fields, evicted from the far end when the table would
 * exceed the size its owner has been told to keep.
 *
 * Entries are indexed from the newest, and continue the numbering
 * where the static table stops, so index 62 is always the most
 * recently added entry.
 */
class DynamicTable {

  var _entries = []
  var _size = 0
  var _capacity = 4096

  /**
   * @param ?number capacity: the maximum table size in bytes;
   *    defaults to HPACK's own default of 4096
   */
  @new(capacity) {
    self._entries = []
    self._size = 0
    self._capacity = capacity == nil ? 4096 : capacity
  }

  /**
   * Adds a field, evicting from the oldest end until it fits.
   *
   * An entry larger than the whole table is not an error: RFC 7541
   * §4.4 says to empty the table and add nothing, which is what
   * happens here.
   *
   * @param string name
   * @param string value
   */
  add(name: string, value: string) {
    var cost = _entry_size(name, value)

    while self._size + cost > self._capacity and self._entries.length() > 0 {
      var evicted = self._entries.pop()
      self._size -= _entry_size(evicted[0], evicted[1])
    }

    if cost > self._capacity {
      return
    }

    self._entries.insert([name, value], 0)
    self._size += cost
  }

  /**
   * The entry at HPACK index `index`, which counts the static table
   * first.
   *
   * @param number index
   * @returns list: `[name, value]`
   * @throws ProtocolError if the index names nothing
   */
  get(index: number) {
    if index < 1 {
      raise ProtocolError('HPACK index 0 is not valid')
    }

    if index <= _STATIC_LENGTH {
      return _STATIC[index]
    }

    var at = index - _STATIC_LENGTH - 1

    if at >= self._entries.length() {
      raise ProtocolError('HPACK index ${index} is past the end of the table')
    }

    return self._entries[at]
  }

  /**
   * Changes the table's maximum size, evicting whatever no longer
   * fits.
   *
   * @param number capacity
   */
  set_capacity(capacity: number) {
    self._capacity = capacity

    while self._size > self._capacity and self._entries.length() > 0 {
      var evicted = self._entries.pop()
      self._size -= _entry_size(evicted[0], evicted[1])
    }
  }

  /**
   * The table's current maximum size in bytes.
   *
   * @returns number
   */
  capacity() {
    return self._capacity
  }

  /**
   * How many bytes the entries currently occupy, by HPACK's
   * accounting (name plus value plus 32 per entry).
   *
   * @returns number
   */
  size() {
    return self._size
  }

  /**
   * The list of entries currently held in the table.
   *
   * @returns list
   */
  entries() {
    return self._entries
  }

  /**
   * How many entries the table holds.
   *
   * @returns number
   */
  length() {
    return self._entries.length()
  }
}

def _entry_size(name, value) {
  return name.length() + value.length() + 32
}

/**
 * Decodes header blocks for one direction of one connection.
 *
 * A decoder is stateful and order-dependent: it must see every header
 * block on its connection, in order, or its dynamic table drifts out
 * of step with the peer's encoder and every block after that decodes
 * to nonsense.
 */
class Decoder {

  var table

  /**
   * The largest single string literal accepted. A peer can otherwise
   * declare a header value of any length it likes.
   * @type number
   */
  var max_string_length = 32768

  /**
   * The largest decoded header list accepted, by HPACK's own size
   * accounting.
   * @type number
   */
  var max_header_list_size = 262144

  /**
   * @param ?number capacity: the initial dynamic table size
   */
  @new(capacity) {
    self.table = DynamicTable(capacity)
  }

  /**
   * Decodes a complete header block into a list of `[name, value]`
   * pairs, in the order they appeared - which HTTP/2 depends on, as
   * repeated fields keep their order and `Set-Cookie` may appear many
   * times.
   *
   * @param bytes block
   * @returns list
   * @throws ProtocolError on a malformed block or one that exceeds a
   *    limit
   */
  decode(block) {
    var res = _http.hpack_decode_block(
      block,
      self.table.entries(),
      self.table.capacity(),
      self.table.size(),
      self.max_string_length,
      self.max_header_list_size,
    )

    if res[0] != 'ok' {
      raise ProtocolError(res[1])
    }

    var fields = res[1]
    var new_capacity = res[2]
    if new_capacity != self.table.capacity() {
      self.table.set_capacity(new_capacity)
    }

    var added = res[3]
    if added.length() > 0 {
      for entry in added {
        self.table.add(entry[0], entry[1])
      }
    }

    return fields
  }
}

# RFC 9113 §8.2.1: a field name in HTTP/2 must be lowercase, and must
# be a valid token besides. An uppercase name is not a stylistic slip
# to normalise away - it is how a request is made to mean one thing to
# a proxy and another to an origin.
def _check_name(name) {
  if name.is_empty() {
    raise ProtocolError('empty header field name')
  }

  iter var i = 0; i < name.length(); i++ {
    var c = name[i].ord()

    if c >= 65 and c <= 90 {
      raise ProtocolError('header field name ${name} is not lowercase')
    }

    if c <= 32 or c == 58 and i > 0 or c == 127 {
      # A colon is only legal as the first character, where it marks a
      # pseudo-header.
      raise ProtocolError('invalid character in header field name: ${name}')
    }
  }
}

/**
 * Encodes header blocks for one direction of one connection.
 *
 * Fields are matched against the static table, and anything not found
 * there is written out as a literal without indexing - see the module
 * note above for why the dynamic table is left empty.
 */
class Encoder {

  # Tracked only so that a size update from the peer can be honoured
  # and acknowledged; nothing is ever inserted.
  var _capacity = 4096

  @new(capacity) {
    self._capacity = capacity == nil ? 4096 : capacity
  }

  /**
   * Notes the maximum dynamic table size the peer will accept.
   *
   * @param number capacity
   */
  set_capacity(capacity: number) {
    self._capacity = capacity
  }

  /**
   * Encodes a list of `[name, value]` pairs into a header block.
   *
   * Names must already be lowercase; HTTP/2 has no other kind.
   *
   * @param list fields
   * @returns bytes
   */
  encode(fields: list) {
    return _http.hpack_encode_block(fields)
  }
}
