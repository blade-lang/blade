/**
 * Test suite for `rpc`: JSON-RPC 2.0 messages, the two framings, the
 * transports, and endpoints talking to each other across isolates and
 * across processes.
 */

import rpc
import isolate
import os
import json

var _passed = 0

def ok(label) {
  _passed++
  echo '  [PASS] ' + label
}

def raises(fn, kind) {
  catch {
    fn()
    return nil
  } as error {
    if !instance_of(error, kind) {
      raise error
    }

    return error
  }
}

echo '═══════════════════════════════════════════════════════'
echo '  rpc: test suite'
echo '═══════════════════════════════════════════════════════'

# ---------------------------------------------------------------------------
# Messages
# ---------------------------------------------------------------------------
var call_text = '{"jsonrpc": "2.0", "id": 7, "method": "add", "params": [1, 2]}'
var call = rpc.decode(call_text)
assert instance_of(call, rpc.Request), 'a message with an id is a request'
assert call.method == 'add' and call.id == 7 and call.params == [1, 2], 'with its parts'

var note = rpc.decode('{"jsonrpc": "2.0", "method": "tick"}')
assert instance_of(note, rpc.Notification), 'a message without an id is a notification'
assert note.params == nil, 'which may carry no params'

var null_id = rpc.decode('{"jsonrpc": "2.0", "id": null, "method": "x"}')
assert instance_of(null_id, rpc.Request) and null_id.id == nil, 'a null id is still a request'

var answer = rpc.decode('{"jsonrpc": "2.0", "id": 7, "result": 3}')
assert instance_of(answer, rpc.Response) and !answer.is_error(), 'a result is a response'
assert answer.result == 3, 'carrying the result'

var failure = rpc.decode('{"jsonrpc": "2.0", "id": 7, "error": {"code": -32601, "message": "no"}}')
assert failure.is_error() and failure.error.code == -32601, 'an error is a failed response'
ok('decode() reads requests, notifications and responses')

var invalid = [
  '[]',
  '{"id": 1, "method": "x"}',
  '{"jsonrpc": "1.0", "id": 1, "method": "x"}',
  '{"jsonrpc": "2.0", "id": 1, "method": 5}',
  '{"jsonrpc": "2.0", "id": 1, "method": "x", "params": 3}',
  '{"jsonrpc": "2.0", "id": true, "method": "x"}',
  '{"jsonrpc": "2.0", "id": 1}',
  '{"jsonrpc": "2.0", "id": 1, "result": 1, "error": {"code": 1, "message": "m"}}',
  '{"jsonrpc": "2.0", "id": 1, "error": {"code": 1.5, "message": "m"}}',
  '"just a string"',
]

for text in invalid {
  var error = raises(@() => rpc.decode(text), rpc.RpcError)
  assert error != nil and error.code == rpc.INVALID_REQUEST, '${text} is not a message'
}

var unparsed = raises(@() => rpc.decode('{not json'), rpc.RpcError)
assert unparsed.code == rpc.PARSE_ERROR, 'text that is not JSON is a parse error'
ok('decode() refuses everything JSON-RPC does not allow')

var batch_text_in = '[{"jsonrpc": "2.0", "method": "a"}, 5, ' +
  '{"jsonrpc": "2.0", "id": 2, "method": "b"}]'
var batch = rpc.decode(batch_text_in)
assert batch.length() == 3, 'a batch reads each entry'
assert instance_of(batch[0], rpc.Notification), 'keeping each message'
assert instance_of(batch[1], rpc.RpcError), 'and an error for each entry that is not one'
assert instance_of(batch[2], rpc.Request), 'in order'
ok('decode() reads a batch entry by entry')

var request_text = rpc.encode(rpc.Request('add', [2, 3], 1))
assert json.decode(request_text) == { jsonrpc: '2.0', id: 1, method: 'add', params: [2, 3] },
  'a request encodes as JSON-RPC sends it'
var bare = json.decode(rpc.encode(rpc.Notification('ping', nil)))
assert raises(@() => rpc.Request('add', 'two', 1), ValueError) != nil,
  'a request is never built with params JSON-RPC cannot carry'
assert !bare.contains('params') and !bare.contains('id'), 'nothing absent is sent'
var failed = json.decode(rpc.encode(rpc.Response.failure(4, rpc.RpcError(-1, 'bad', { at: 2 }))))
assert failed.error == { code: -1, message: 'bad', data: { at: 2 } }, 'an error sends its data'
ok('encode() writes every message as JSON-RPC sends it')

# ---------------------------------------------------------------------------
# HeaderFraming
# ---------------------------------------------------------------------------
var framing = rpc.HeaderFraming()
var framed = framing.frame('{"a":"é😀"}')
assert framed.to_string().starts_with('Content-Length: 14\r\n\r\n'),
  'the length counts the 14 bytes of the 10 characters'

var stream = framed + framing.frame('{"b":2}')
var pieces = []
iter var i = 0; i < stream.length(); i++ {
  pieces.extend(framing.feed(stream[i, i + 1]))
}
assert pieces.map(@(p) => p.to_string()) == ['{"a":"é😀"}', '{"b":2}'],
  'fed a byte at a time, every message comes out whole'
assert framing.pending() == 0, 'leaving nothing behind'

var together = framing.feed(stream)
assert together.length() == 2, 'two messages in one piece both come out'

var extra = 'content-length: 2\r\nContent-Type: application/vscode-jsonrpc; charset=utf-8\r\n\r\n{}'
assert framing.feed(extra.to_bytes()).length() == 1, 'header names are read without regard to case'
ok('HeaderFraming finds every message however the stream is split')

var broken = [
  'Content-Type: application/json\r\n\r\n{}',
  'Content-Length: two\r\n\r\n{}',
  'Content-Length 2\r\n\r\n{}',
  'Content-Length: 2\r\nContent-Type: text/plain; charset=latin1\r\n\r\n{}',
  'Content-Length: 2\r\nX-Name: é\r\n\r\n{}',
]

for text in broken {
  var error = raises(@() => rpc.HeaderFraming().feed(text.to_bytes()), rpc.RpcFramingError)
  assert error != nil, '${text} is not a framed message'
}

var small = rpc.HeaderFraming().set_max_size(10)
assert small.max_size() == 10, 'the limit can be set'
var too_long = 'Content-Length: 11\r\n\r\n'.to_bytes()
assert raises(@() => small.feed(too_long), rpc.RpcFramingError) != nil,
  'a message over the limit is refused before it arrives'

var endless = 'X: '.to_bytes() + bytes(9000)
assert raises(@() => rpc.HeaderFraming().feed(endless), rpc.RpcFramingError) != nil,
  'a header block with no end is refused'
ok('HeaderFraming refuses what cannot be read')

# ---------------------------------------------------------------------------
# LineFraming
# ---------------------------------------------------------------------------
var lines = rpc.LineFraming()
var first = lines.feed('{"a":1}\r\n\n{"b"'.to_bytes())
assert first.map(@(l) => l.to_string()) == ['{"a":1}'], 'a line ending in \\r\\n is one message'
assert lines.pending() == 4, 'an unfinished line is held'
assert lines.feed(':2}\n'.to_bytes())[0].to_string() == '{"b":2}', 'and finished by the next piece'
assert lines.frame('{}').to_string() == '{}\n', 'a message is sent as a line'

var short_lines = rpc.LineFraming().set_max_size(4)
assert raises(@() => short_lines.feed('12345'.to_bytes()), rpc.RpcFramingError) != nil,
  'a line over the limit is refused'
ok('LineFraming reads one message to a line')

# ---------------------------------------------------------------------------
# Endpoints over a pipe between isolates
# ---------------------------------------------------------------------------
def serve_test_api(transport) {
  import rpc

  var seen = []
  var waiting = []
  var fallen_back = []
  var server = rpc.endpoint(transport)

  server
    .on_request('add', @(params) => params[0] + params[1])
    .on_request('greet', @(params) => 'Hello, ${params.name}!')
    .on_request('refuse', @(params) {
      raise rpc.RpcError(-32001, 'refused', { reason: params[0] })
    })
    .on_request('crash', @(params) {
      raise ValueError('it broke')
    })
    .on_notification('note', @(params) {
      seen.append(params)
    })
    .on_request('notes', @(params) => seen)
    .on_request('later', @(params, context) {
      waiting.append(context.defer())
    })
    .on_notification('release', @(params) {
      for context in waiting {
        context.reply(params)
      }

      waiting = []
    })
    .on_request('later_refused', @(params, context) {
      context.defer().fail(rpc.RpcError(-32002, 'not today'))
    })
    .on_request('deferred_crash', @(params, context) {
      context.defer()
      raise ValueError('broke after deferring')
    })
    .on_request('reply_early', @(params, context) {
      catch {
        context.reply(1)
      } as error {
        return error.message
      }
    })
    .on_unhandled(@(params, context) {
      if context.is_notification() {
        fallen_back.append(context.method)
        return
      }

      if context.method.starts_with('echo.') {
        return [context.method, params]
      }

      if context.method == 'fallen_back' {
        return fallen_back
      }

      raise rpc.RpcError(rpc.METHOD_NOT_FOUND, 'Method not found: ${context.method}')
    })
    .on_request('ask', @(params, context) {
      return context.endpoint.request('question', params) + 1
    })
    .on_error(@(error, value) {
      server.notify('server_error', [error.message])
    })
    .serve()
}

var ends = rpc.pipe()
var server_task = isolate.spawn(serve_test_api, ends[1])
var errors = []
var client = rpc.endpoint(ends[0])
  .on_request('question', @(params) => params[0] * 10)
  .on_notification('server_error', @(params) {
    errors.append(params[0])
  })

assert client.request('add', [2, 3]) == 5, 'a request is answered'
assert client.request('greet', { name: 'Zuri' }) == 'Hello, Zuri!', 'with params by name too'

var missing = raises(@() => client.request('nothing', nil), rpc.RpcError)
assert missing.code == rpc.METHOD_NOT_FOUND, 'a method with no handler is not found'

var refused = raises(@() => client.request('refuse', ['policy']), rpc.RpcError)
assert refused.code == -32001 and refused.message == 'refused', 'an RpcError goes back as it is'
assert refused.data == { reason: 'policy' }, 'data included'

var crashed = raises(@() => client.request('crash', nil), rpc.RpcError)
assert crashed.code == rpc.INTERNAL_ERROR and crashed.message == 'it broke',
  'any other error is an internal error carrying its message'
ok('requests are answered with results and errors')

client.notify('note', ['one'])
client.notify('note', ['two'])
assert client.request('notes', nil) == [['one'], ['two']],
  'notifications reach their handler in order'
assert errors == ['it broke'], 'and the server was told of the crash through on_error'
ok('notifications are delivered and errors reported')

assert client.request('ask', [4]) == 41, 'a handler can ask the caller something before answering'
ok('either side can call the other in the middle of a request')

# A deferred request is answered by a later message.
var inbox = client.listen()
var answered = []
client.send_request('later', nil, @(result, error) {
  answered.append(result)
})
client.notify('release', ['done'])

while answered.is_empty() {
  client.dispatch(inbox.recv(5))
}

assert answered == [['done']], 'a deferred request is answered when its reply is sent'

var refused_later = raises(@() => client.request('later_refused', nil), rpc.RpcError)
assert refused_later.code == -32002, 'a deferred request can fail'

var crashed_later = raises(@() => client.request('deferred_crash', nil), rpc.RpcError)
assert crashed_later.code == rpc.INTERNAL_ERROR, 'a handler that raises after deferring fails it'

var early = client.request('reply_early', nil)
assert early == 'only a deferred request is answered through its context',
  'a request that was not deferred cannot be answered through its context'
ok('send_request() calls back with a deferred answer')

assert client.request('echo.twice', [2]) == ['echo.twice', [2]],
  'a method with no handler reaches the fallback'
client.notify('stray.note', nil)
assert client.request('fallen_back', nil) == ['stray.note'],
  'and so does a notification'

var still_missing = raises(@() => client.request('nothing.at.all', nil), rpc.RpcError)
assert still_missing.code == rpc.METHOD_NOT_FOUND, 'the fallback can refuse a method'

var reserved = raises(@() => client.request('rpc.echo', nil), rpc.RpcError)
assert reserved.code == rpc.METHOD_NOT_FOUND, 'reserved names never reach the fallback'
ok('on_unhandled() catches what no handler does')

var batch_answers = client.request_batch([
  ['add', [1, 2]],
  ['refuse', ['batch']],
  ['greet', { name: 'Batch' }],
])
assert batch_answers[0] == 3 and batch_answers[2] == 'Hello, Batch!',
  'a batch is answered in the order it was sent'
assert instance_of(batch_answers[1], rpc.RpcError) and batch_answers[1].code == -32001,
  'with each failed call as its error'
assert raises(@() => client.request_batch([]), ValueError) != nil, 'an empty batch is refused'
assert raises(@() => client.request_batch([['add']]), ValueError) != nil,
  'and so is a call that is not a pair'
ok('request_batch() sends a batch and collects every answer')

var timeout = raises(@() => client.request('later', nil, 0.2), rpc.RpcTimeoutError)
assert timeout != nil, 'a listening endpoint gives up after its timeout'
client.notify('release', ['late'])
ok('request() times out')

var traced = []
client.on_trace(@(direction, text) {
  traced.append(direction)
})
client.request('add', [1, 1])
assert traced.contains('out') and traced.contains('in'), 'every message is traced both ways'
ok('on_trace() sees the conversation')

assert raises(@() => client.on_request('rpc.discover', @() => 1), ValueError) != nil,
  'rpc. names are reserved'
ok('reserved method names are refused')

client.close()
assert client.is_closed(), 'a closed endpoint says so'
assert raises(@() => client.notify('note', ['x']), rpc.RpcClosedError) != nil,
  'and sends nothing more'
server_task.join(5)
ok('closing one end ends the other')

# ---------------------------------------------------------------------------
# The wire, byte for byte
# ---------------------------------------------------------------------------
def answer_raw(sent) {
  var wire = rpc.pipe()
  var task = isolate.spawn(serve_test_api, wire[1])
  var reading = rpc.HeaderFraming()

  wire[0].write(reading.frame(sent))

  var replies = []
  while replies.is_empty() {
    replies = reading.feed(wire[0].read(4096))
  }

  wire[0].close()
  task.join(5)

  return json.decode(replies[0].to_string())
}

var parse_reply = answer_raw('{nonsense')
assert parse_reply.id == nil and parse_reply.error.code == rpc.PARSE_ERROR,
  'text that is not JSON is answered with a parse error and a null id'

var version_reply = answer_raw('{"jsonrpc": "1.0", "id": 9, "method": "add"}')
assert version_reply.id == 9 and version_reply.error.code == rpc.INVALID_REQUEST,
  'an invalid request is answered with its own id'

var empty_reply = answer_raw('[]')
assert empty_reply.error.code == rpc.INVALID_REQUEST, 'an empty batch is invalid'

var batch_text = '[{"jsonrpc": "2.0", "id": 1, "method": "add", "params": [1, 2]}, ' +
  '{"jsonrpc": "2.0", "method": "note", "params": ["x"]}, 7]'
var batch_reply = answer_raw(batch_text)
assert is_list(batch_reply) and batch_reply.length() == 2, 'a batch is answered as a batch'
assert batch_reply[0].result == 3, 'each request answered in order'
assert batch_reply[1].error.code == rpc.INVALID_REQUEST, 'each bad entry answered on its own'

# Read as U+FFFD, the 0xff would make this a valid request.
var unreadable = '{"jsonrpc": "2.0", "id": 5, "method": "greet", "params": {"name": "'.to_bytes() +
  bytes([0xff]) + '"}}'.to_bytes()
var unreadable_reply = answer_raw(unreadable)
assert unreadable_reply.id == nil and unreadable_reply.error.code == rpc.PARSE_ERROR,
  'a message that is not UTF-8 is answered with a parse error'

var replacement_text = '{"jsonrpc": "2.0", "id": 3, "method": "greet", ' +
  '"params": {"name": "\ufffd"}}'
assert answer_raw(replacement_text).result == 'Hello, \ufffd!',
  'while U+FFFD itself is valid UTF-8'
ok('the wire carries exactly what JSON-RPC requires')

var raw = rpc.pipe()
var listener = rpc.endpoint(raw[0])
var listened = listener.listen()

raw[1].write(rpc.HeaderFraming().frame('{"jsonrpc": "2.0", "method": "tick"}'))

var decoded_item = listened.recv(5)
assert decoded_item.kind == 'message' and decoded_item.value.method == 'tick',
  'listen() decodes each message before handing it over'

raw[1].write(rpc.HeaderFraming().frame(unreadable))

var unreadable_item = listened.recv(5)
assert unreadable_item.kind == 'unreadable' and unreadable_item.text == nil,
  'and hands over no text for a message that is not UTF-8'

listener.dispatch(unreadable_item)

var raw_reading = rpc.HeaderFraming()
var raw_replies = []
while raw_replies.is_empty() {
  raw_replies = raw_reading.feed(raw[1].read(4096))
}

assert json.decode(raw_replies[0].to_string()).error.code == rpc.PARSE_ERROR,
  'which dispatch() answers with a parse error'

listener.close()
raw[1].close()
ok('a listening endpoint refuses text that is not UTF-8')

# ---------------------------------------------------------------------------
# A child process over its standard streams
# ---------------------------------------------------------------------------
var server_script = os.join_paths(os.dir_name(__file__), '_rpc_stdio_server.zu')
var child = os.spawn(os.args[0], ['run', server_script], { stdin: 'pipe', stdout: 'pipe' })
var remote = rpc.endpoint(rpc.process(child))

assert remote.request('echo', { text: 'hé' }) == { text: 'hé' }, 'a child answers over its stdio'
assert raises(@() => remote.listen(), ValueError) != nil, 'a child is read where it was spawned'
assert remote.request('stop', nil) == 'stopping', 'and keeps answering until it stops'
remote.close()
assert child.wait(10000) == 0, 'the child ends cleanly'
ok('ProcessTransport and StdioTransport talk across processes')

echo ''
echo '═══════════════════════════════════════════════════════'
echo '  All ${_passed} assertions passed.'
echo '═══════════════════════════════════════════════════════'
