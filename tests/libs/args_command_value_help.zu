# --help after a command that takes a value shows that command's usage
# and calls os.exit(0), which terminates the process, so this is spawned
# as a real subprocess from tests/libs/args.zu rather than run
# in-process. No .out file on purpose: it's a helper, not a fixture in
# its own right.
import args

var p = args.Parser('commandhelp', false)
p.add_command('new', 'Makes things', { type: args.LIST, metavar: 'name' })
p.parse(['new', '--help'])
